{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 26, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/${presetName}/vcpkg_installed"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (x64)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "ninja",
      "displayName": "Ninja (RelWithDebInfo, run from a VS x64 developer prompt)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "core",
      "displayName": "Core only, without Houdini (Ninja, Release; system libraries)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "NOVA_CORE_ONLY": "ON", "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "core-sanitize",
      "displayName": "Core only with AddressSanitizer and UBSan, float casts included (GCC or Clang)",
      "inherits": "core",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined,float-cast-overflow -fno-sanitize-recover=all -fno-omit-frame-pointer"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "vs2022", "configuration": "Release" },
    { "name": "relwithdebinfo", "configurePreset": "vs2022", "configuration": "RelWithDebInfo" },
    { "name": "ninja", "configurePreset": "ninja" },
    { "name": "core", "configurePreset": "core" },
    { "name": "core-sanitize", "configurePreset": "core-sanitize" }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "vs2022",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ninja",
      "configurePreset": "ninja",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "core",
      "configurePreset": "core",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "core-sanitize",
      "configurePreset": "core-sanitize",
      "output": { "outputOnFailure": true }
    }
  ]
}
