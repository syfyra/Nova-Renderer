# Embeds a binary file as a C++ source (docs/design/M10.md D2):
#   cmake -DINPUTS=<file;...> -DOUT=<source.cpp> -DNAME=<identifier> -P embed.cmake
# defines `const unsigned long long NAME_words[]` (the bytes, little-endian
# 64-bit words, zero-padded) and `const std::size_t NAME_size` (the byte
# count) in namespace nova::gpu, declared in core/gpu/embedded.h. Words keep
# MSVC fast: a 4.5 MB fatbin as single bytes took minutes to compile. The
# first existing input is taken (a target's object list may name one file).

foreach(input IN LISTS INPUTS)
    if(EXISTS "${input}")
        set(_file "${input}")
        break()
    endif()
endforeach()
if(NOT _file)
    message(FATAL_ERROR "embed.cmake: none of ${INPUTS} exists")
endif()
file(READ "${_file}" _hex HEX)
string(LENGTH "${_hex}" _len)
math(EXPR _bytes "${_len} / 2")
math(EXPR _pad "(8 - ${_bytes} % 8) % 8")
set(_i 0)
while(_i LESS _pad)
    string(APPEND _hex "00")
    math(EXPR _i "${_i} + 1")
endwhile()
# Each 8 bytes b0..b7 become the word 0xb7b6...b0.
string(REGEX REPLACE "(..)(..)(..)(..)(..)(..)(..)(..)" "0x\\8\\7\\6\\5\\4\\3\\2\\1," _body "${_hex}")
# Lines of 8 words.
string(REGEX REPLACE "((0x[0-9a-f]+,){8})" "\\1\n    " _body "${_body}")
file(WRITE "${OUT}.tmp" "// Generated by core/gpu/embed.cmake from ${_file}: do not edit.\n"
     "#include \"core/gpu/embedded.h\"\n\nnamespace nova::gpu {\n\n"
     "const unsigned long long ${NAME}_words[] = {\n    ${_body}0};\nconst std::size_t ${NAME}_size = ${_bytes};\n\n"
     "} // namespace nova::gpu\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
