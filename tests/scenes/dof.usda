#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

# Depth of field reference scene (M2). A card covering x >= 0 at depth 20 in
# front of a camera focused at 10 (focal length 50 mm, aperture 36 mm,
# f-stop 2, 256 x 128 pixels). Its edge projects onto the image centre and is
# blurred by a disk of radius
#   rho = f^2 |z - s| W / (2 N z s A) = 25 * 10 * 256 / (2 * 2 * 20 * 10 * 3.6) = 22.22 px
# (HdCamera lengths in world units: focal length 5, aperture 3.6); Karma CPU
# measures 22.12 px. A second card at the focus distance stays sharp.
def Xform "World"
{
    def Mesh "far"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(0, -1, -20), (50, -1, -20), (50, 50, -20), (0, 50, -20)]
        uniform token subdivisionScheme = "none"
    }

    # In focus: covers x >= 0 below y = -1 at depth 10 (the lower image half).
    def Mesh "near"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(0, -50, -10), (50, -50, -10), (50, -1.5, -10), (0, -1.5, -10)]
        uniform token subdivisionScheme = "none"
    }

    def Camera "cam"
    {
        float focalLength = 50
        float horizontalAperture = 36
        float verticalAperture = 18
        float fStop = 2
        float focusDistance = 10
        float2 clippingRange = (0.1, 1000)
    }
}

def Scope "Render"
{
    def RenderSettings "settings"
    {
        rel camera = </World/cam>
        int2 resolution = (256, 128)
        int nova:samples = 256
        int nova:maxDepth = 1
        token nova:pixelFilter = "point"
    }

    def RenderSettings "nodof"
    {
        rel camera = </World/cam>
        int2 resolution = (256, 128)
        int nova:samples = 16
        int nova:maxDepth = 1
        token nova:pixelFilter = "point"
        bool disableDepthOfField = 1
    }
}
