#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    framesPerSecond = 24
)

# Velocity and acceleration blur (docs/design/M8.md D19), rendered at frame 1
# with the camera shutter [-0.25, 0.25] frames = 1/48 s at 24 time codes per
# second. Orthographic camera: 40 x 24 units on 400 x 240 pixels (10 px per
# unit), x from -20 to 20, y from -12 to 12. Nothing has time samples unless
# noted; velocities of 240 units per second move 5 units over the shutter.
def Xform "World"
{
    # Row y [9, 11]: no setting renders sharp; Nova's own setting blurs.
    def Mesh "still"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-16, 9, 0), (-14, 9, 0), (-14, 11, 0), (-16, 11, 0)]
        vector3f[] velocities = [(240, 0, 0), (240, 0, 0), (240, 0, 0), (240, 0, 0)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "velocityNova"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(0, 9, 0), (2, 9, 0), (2, 11, 0), (0, 11, 0)]
        vector3f[] velocities = [(240, 0, 0), (240, 0, 0), (240, 0, 0), (240, 0, 0)]
        uniform token subdivisionScheme = "none"
        int primvars:nova:object:velocityBlur = 1 (interpolation = "constant")
    }

    # Row y [5, 7]: Karma's vblur inherited from a parent; Nova's own setting
    # on a child wins over it.
    def Xform "karmaGroup"
    {
        int primvars:karma:object:vblur = 1 (interpolation = "constant")

        def Mesh "inherited"
        {
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            point3f[] points = [(0, 5, 0), (2, 5, 0), (2, 7, 0), (0, 7, 0)]
            vector3f[] velocities = [(240, 0, 0), (240, 0, 0), (240, 0, 0), (240, 0, 0)]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "overridden"
        {
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            point3f[] points = [(-16, 5, 0), (-14, 5, 0), (-14, 7, 0), (-16, 7, 0)]
            vector3f[] velocities = [(240, 0, 0), (240, 0, 0), (240, 0, 0), (240, 0, 0)]
            uniform token subdivisionScheme = "none"
            int primvars:nova:object:velocityBlur = 0 (interpolation = "constant")
        }
    }

    # Row y [1, 3]: accelerations of 46080 units/s^2 move the left edge by
    # 2.5 u + 2.5 u^2 (u = -1 at shutter open, 1 at close): acceleration
    # blur with 8 samples, and velocity blur, which ignores them.
    def Mesh "acceleration"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(0, 1, 0), (2, 1, 0), (2, 3, 0), (0, 3, 0)]
        vector3f[] velocities = [(240, 0, 0), (240, 0, 0), (240, 0, 0), (240, 0, 0)]
        vector3f[] accelerations = [(46080, 0, 0), (46080, 0, 0), (46080, 0, 0), (46080, 0, 0)]
        uniform token subdivisionScheme = "none"
        int primvars:karma:object:vblur = 2 (interpolation = "constant")
        int primvars:nova:object:accelerationSamples = 8 (interpolation = "constant")
    }

    def Mesh "accelerationIgnored"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-16, 1, 0), (-14, 1, 0), (-14, 3, 0), (-16, 3, 0)]
        vector3f[] velocities = [(240, 0, 0), (240, 0, 0), (240, 0, 0), (240, 0, 0)]
        vector3f[] accelerations = [(46080, 0, 0), (46080, 0, 0), (46080, 0, 0), (46080, 0, 0)]
        uniform token subdivisionScheme = "none"
        int primvars:karma:object:vblur = 1 (interpolation = "constant")
    }

    # Row y [-3, -1]: time samples (10 units per frame) and velocities of 480:
    # velocity blur follows the velocities (the left edge sweeps [-5, 5]);
    # a point (sphere of width 2) blurred by its velocity.
    def Mesh "sampled"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points.timeSamples = {
            0: [(-10, -3, 0), (-8, -3, 0), (-8, -1, 0), (-10, -1, 0)],
            1: [(0, -3, 0), (2, -3, 0), (2, -1, 0), (0, -1, 0)],
            2: [(10, -3, 0), (12, -3, 0), (12, -1, 0), (10, -1, 0)],
        }
        vector3f[] velocities = [(480, 0, 0), (480, 0, 0), (480, 0, 0), (480, 0, 0)]
        uniform token subdivisionScheme = "none"
        int primvars:karma:object:vblur = 1 (interpolation = "constant")
    }

    def Points "point"
    {
        point3f[] points = [(-15, -2, 0)]
        float[] widths = [2] (interpolation = "vertex")
        vector3f[] velocities = [(240, 0, 0)]
        int primvars:karma:object:vblur = 1 (interpolation = "constant")
    }

    # Row y [-7, -5]: a linear curve of width 1 at x = 1, and the instance of a
    # point instancer (a 2 x 2 quad at x = -15) moving by the instancer's
    # velocities.
    def BasisCurves "curve"
    {
        uniform token type = "linear"
        int[] curveVertexCounts = [2]
        point3f[] points = [(1, -7, 0), (1, -5, 0)]
        float[] widths = [1, 1] (interpolation = "vertex")
        vector3f[] velocities = [(240, 0, 0), (240, 0, 0)]
        int primvars:karma:object:vblur = 1 (interpolation = "constant")
    }

    def PointInstancer "movingInstances"
    {
        point3f[] positions = [(-15, -6, 0)]
        vector3f[] velocities = [(240, 0, 0)]
        int[] protoIndices = [0]
        rel prototypes = </World/movingInstances/protos/quad>
        int primvars:karma:object:instance_vblur = 1 (interpolation = "constant")

        def Scope "protos"
        {
            def Mesh "quad"
            {
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
                uniform token subdivisionScheme = "none"
            }
        }
    }

    # Row y [-11.5, -8.5]: instances turning 90 degrees over the shutter by
    # their angular velocities (degrees per second) with Nova's instance
    # setting at x = 12; the same instancer without a setting at x = -12.
    def PointInstancer "spinningInstances"
    {
        point3f[] positions = [(12, -10, 0)]
        vector3f[] angularVelocities = [(0, 0, 4320)]
        int[] protoIndices = [0]
        rel prototypes = </World/spinningInstances/protos/quad>
        int primvars:nova:object:instanceVelocityBlur = 1 (interpolation = "constant")

        def Scope "protos"
        {
            def Mesh "quad"
            {
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
                uniform token subdivisionScheme = "none"
            }
        }
    }

    def PointInstancer "stillInstances"
    {
        point3f[] positions = [(-12, -10, 0)]
        vector3f[] angularVelocities = [(0, 0, 4320)]
        int[] protoIndices = [0]
        rel prototypes = </World/stillInstances/protos/quad>

        def Scope "protos"
        {
            def Mesh "quad"
            {
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
                uniform token subdivisionScheme = "none"
            }
        }
    }

    def DomeLight "sky"
    {
        float inputs:intensity = 1
    }

    def Camera "cam"
    {
        token projection = "orthographic"
        float horizontalAperture = 400
        float verticalAperture = 240
        float2 clippingRange = (0.1, 100)
        double shutter:open = -0.25
        double shutter:close = 0.25
        double3 xformOp:translate = (0, 0, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

def Scope "Render"
{
    def RenderSettings "settings"
    {
        rel camera = </World/cam>
        int2 resolution = (400, 240)
        int nova:samples = 64
        int nova:maxDepth = 1
        token nova:pixelFilter = "box"
    }

    # Karma's render-settings default: velocity blur for every object that
    # sets nothing ("still" blurs, "overridden" stays sharp).
    def RenderSettings "karmaDefault"
    {
        rel camera = </World/cam>
        int2 resolution = (400, 240)
        int nova:samples = 64
        int nova:maxDepth = 1
        token nova:pixelFilter = "box"
        token karma:object:vblur = "Velocity Blur"
        int karma:object:instance_vblur = 1
    }

    def RenderSettings "nomotion"
    {
        rel camera = </World/cam>
        int2 resolution = (400, 240)
        int nova:samples = 16
        int nova:maxDepth = 1
        token nova:pixelFilter = "box"
        bool disableMotionBlur = 1
    }
}
