#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    subLayers = [@./basic.usda@]
)

# basic.usda with one multi-AOV render product (color, depth, normal, albedo, primId).
def Scope "Render"
{
    def RenderSettings "aovs"
    {
        rel camera = </World/cam>
        int2 resolution = (320, 214)
        rel products = </Render/Products/aovs>
        int nova:samples = 16
    }

    def Scope "Products"
    {
        def RenderProduct "aovs"
        {
            token productName = "aovs.exr"
            token productType = "raster"
            rel orderedVars = [
                </Render/Vars/color>,
                </Render/Vars/depth>,
                </Render/Vars/normal>,
                </Render/Vars/albedo>,
                </Render/Vars/primId>,
            ]
        }
    }

    def Scope "Vars"
    {
        def RenderVar "color" (
            prepend apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            string driver:parameters:aov:husk:name = "C"
            uniform string sourceName = "color"
            uniform token sourceType = "raw"
            uniform token dataType = "color4f"
        }
        def RenderVar "depth" (
            prepend apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            string driver:parameters:aov:husk:name = "depth"
            uniform string sourceName = "depth"
            uniform token sourceType = "raw"
            uniform token dataType = "float"
        }
        def RenderVar "normal" (
            prepend apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            string driver:parameters:aov:husk:name = "N"
            uniform string sourceName = "normal"
            uniform token sourceType = "raw"
            uniform token dataType = "normal3f"
        }
        def RenderVar "albedo" (
            prepend apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            string driver:parameters:aov:husk:name = "albedo"
            uniform string sourceName = "albedo"
            uniform token sourceType = "raw"
            uniform token dataType = "color3f"
        }
        def RenderVar "primId" (
            prepend apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            string driver:parameters:aov:husk:name = "primId"
            uniform string sourceName = "primId"
            uniform token sourceType = "raw"
            uniform token dataType = "int"
        }
    }
}
