#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    subLayers = [@./basic.usda@]
)

# nova_cli must read render settings like husk (tests/cli/check_cli.py):
#   full, overscan  a dataWindowNDC beyond [0, 1] is overscan: husk writes the
#                   data window (-24,0)-(131,83) and the display window 120x80;
#   novars          a product without RenderVars is an error (husk: exit 1);
#   layout          the beauty "C" is the first part, with bare R,G,B,A, in the
#                   type of driver:parameters:aov:format (half);
#   beauty3         without "C", the first color AOV has bare channel names;
#   par             adjustPixelAspectRatio derives the pixel aspect ratio from
#                   the aperture (36 x 24) at the final resolution;
#   formats         the file type comes from driver:parameters:aov:husk:format
#                   (what Solaris' Karma Render Settings write; N uses the
#                   older driver:parameters:aov:format), the channel count
#                   from dataType: C color4h -> R,G,B,A half; depth
#                   float16 -> depth.Z half; N normal3h -> N.x,N.y,N.z half;
#                   Nv float3h (Karma's "vectorh") -> Nv.x,Nv.y,Nv.z half.
def Scope "Render"
{
    def RenderSettings "full"
    {
        token nova:defaultMaterial = "lambert"
        rel camera = </World/cam>
        int2 resolution = (120, 80)
        int nova:samples = 4
    }

    def RenderSettings "overscan"
    {
        token nova:defaultMaterial = "lambert"
        rel camera = </World/cam>
        int2 resolution = (120, 80)
        float4 dataWindowNDC = (-0.2, -0.05, 1.1, 1.0)
        int nova:samples = 4
    }

    def RenderSettings "novars"
    {
        token nova:defaultMaterial = "lambert"
        rel camera = </World/cam>
        int2 resolution = (32, 32)
        rel products = </Render/Products/novars>
    }

    def RenderSettings "layout"
    {
        token nova:defaultMaterial = "lambert"
        rel camera = </World/cam>
        int2 resolution = (32, 32)
        rel products = </Render/Products/layout>
        int nova:samples = 1
    }

    def RenderSettings "beauty3"
    {
        token nova:defaultMaterial = "lambert"
        rel camera = </World/cam>
        int2 resolution = (32, 32)
        rel products = </Render/Products/beauty3>
        int nova:samples = 1
    }

    def RenderSettings "formats"
    {
        token nova:defaultMaterial = "lambert"
        rel camera = </World/cam>
        int2 resolution = (32, 32)
        rel products = </Render/Products/formats>
        int nova:samples = 1
    }
    def RenderSettings "par"
    {
        token nova:defaultMaterial = "lambert"
        rel camera = </World/cam>
        int2 resolution = (160, 160)
        uniform token aspectRatioConformPolicy = "adjustPixelAspectRatio"
        int nova:samples = 1
    }

    def Scope "Products"
    {
        def RenderProduct "novars"
        {
            token productName = "novars.exr"
            token productType = "raster"
        }
        def RenderProduct "layout"
        {
            token productName = "layout.exr"
            token productType = "raster"
            rel orderedVars = [</Render/Vars/normal>, </Render/Vars/color>]
        }
        def RenderProduct "formats"
        {
            token productName = "formats.exr"
            token productType = "raster"
            rel orderedVars = [</Render/Vars/colorHusk>, </Render/Vars/depthHalf>, </Render/Vars/normalHalf>,
                               </Render/Vars/vectorHalf>]
        }
        def RenderProduct "beauty3"
        {
            token productName = "beauty3.exr"
            token productType = "raster"
            rel orderedVars = [</Render/Vars/normal>, </Render/Vars/beauty>]
        }
    }

    def Scope "Vars"
    {
        def RenderVar "color" (
            prepend apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            string driver:parameters:aov:husk:name = "C"
            string driver:parameters:aov:format = "color4h"
            uniform string sourceName = "color"
            uniform token sourceType = "raw"
            uniform token dataType = "color4f"
        }
        def RenderVar "beauty" (
            prepend apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            string driver:parameters:aov:husk:name = "beauty"
            uniform string sourceName = "color"
            uniform token sourceType = "raw"
            uniform token dataType = "color3f"
        }
        def RenderVar "normal" (
            prepend apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            string driver:parameters:aov:husk:name = "N"
            uniform string sourceName = "normal"
            uniform token sourceType = "raw"
            uniform token dataType = "normal3f"
        }
        def RenderVar "colorHusk" (
            prepend apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            string driver:parameters:aov:husk:name = "C"
            token driver:parameters:aov:husk:format = "color4h"
            uniform string sourceName = "color"
            uniform token sourceType = "raw"
            uniform token dataType = "color4f"
        }
        def RenderVar "depthHalf" (
            prepend apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            string driver:parameters:aov:husk:name = "depth"
            token driver:parameters:aov:husk:format = "float16"
            uniform string sourceName = "depth"
            uniform token sourceType = "raw"
            uniform token dataType = "float"
        }
        def RenderVar "normalHalf" (
            prepend apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            string driver:parameters:aov:husk:name = "N"
            token driver:parameters:aov:format = "normal3h"
            uniform string sourceName = "normal"
            uniform token sourceType = "raw"
            uniform token dataType = "normal3f"
        }
        def RenderVar "vectorHalf" (
            prepend apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            string driver:parameters:aov:husk:name = "Nv"
            token driver:parameters:aov:husk:format = "float3h"
            uniform string sourceName = "normal"
            uniform token sourceType = "raw"
            uniform token dataType = "vector3f"
        }
    }
}
