#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

# Render passes (husk --pass): three cards in front of a strip of wall, seen
# by an orthographic camera at 20 pixels per unit. A card covers 40 x 40
# pixels; the wall shows 40 x 10 pixels at each end and is hidden behind the
# cards. tests/husk/check_stage_features.py counts what each pass leaves.
def Xform "World"
{
    def Mesh "a"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3, -1, 0), (-1, -1, 0), (-1, 1, 0), (-3, 1, 0)]
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
    }

    def Mesh "b"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
    }

    def Xform "group"
    {
        def Mesh "c"
        {
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            point3f[] points = [(1, -1, 0), (3, -1, 0), (3, 1, 0), (1, 1, 0)]
            uniform token subdivisionScheme = "none"
            color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        }
    }

    def Mesh "wall"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-4, -0.25, -1), (4, -0.25, -1), (4, 0.25, -1), (-4, 0.25, -1)]
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
    }

    def DomeLight "sky"
    {
        float inputs:intensity = 1
    }

    # Along -z onto the cards: 0.5 / pi more radiance on them.
    def DistantLight "sun"
    {
        float inputs:intensity = 1
        float inputs:angle = 1
        bool inputs:normalize = 1
    }

    def Camera "cam"
    {
        token projection = "orthographic"
        float horizontalAperture = 80
        float verticalAperture = 60
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

def Scope "Render"
{
    def RenderSettings "rs"
    {
        rel camera = </World/cam>
        int2 resolution = (160, 120)
        int nova:samples = 64
    }

    def RenderPass "whole"
    {
        rel renderSource = </Render/rs>
    }

    def RenderPass "prune"
    {
        rel renderSource = </Render/rs>
        rel collection:prune:includes = [</World/a>, </World/sun>]
    }

    def RenderPass "render_visibility"
    {
        rel renderSource = </Render/rs>
        uniform bool collection:renderVisibility:includeRoot = 1
        rel collection:renderVisibility:excludes = [</World/group>, </World/sun>]
    }

    def RenderPass "camera_visibility"
    {
        rel renderSource = </Render/rs>
        uniform bool collection:cameraVisibility:includeRoot = 1
        rel collection:cameraVisibility:excludes = </World/a>
    }

    def RenderPass "matte"
    {
        rel renderSource = </Render/rs>
        rel collection:matte:includes = </World/b>
    }
}
