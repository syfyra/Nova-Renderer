#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

# Basic M1 scene: implicit prims (converted to meshes by UsdImaging), a
# polygon ground plane, a normalized sun and a dim sky dome.
def Xform "World"
{
    def Mesh "ground"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-10, 0, 10), (10, 0, 10), (10, 0, -10), (-10, 0, -10)]
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
    }

    def Sphere "ball"
    {
        double radius = 1
        color3f[] primvars:displayColor = [(0.8, 0.25, 0.15)]
        double3 xformOp:translate = (-1.2, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "box"
    {
        double size = 1.4
        color3f[] primvars:displayColor = [(0.2, 0.4, 0.8)]
        double3 xformOp:translate = (1.4, 0.7, -0.5)
        float3 xformOp:rotateXYZ = (0, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def DomeLight "sky"
    {
        float inputs:intensity = 0.3
        color3f inputs:color = (0.8, 0.9, 1)
        # Lights are invisible to the camera unless this is set (Karma convention).
        bool inputs:karma:light:renderlightgeo = 1
    }

    def DistantLight "sun"
    {
        float inputs:intensity = 2
        float inputs:angle = 0.53
        bool inputs:normalize = 1
        float3 xformOp:rotateXYZ = (-50, 35, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Camera "cam"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 24
        float2 clippingRange = (0.1, 1000)
        double3 xformOp:translate = (0, 2.5, 8)
        float3 xformOp:rotateXYZ = (-12, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
