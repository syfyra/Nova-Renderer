#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

# Instance-rate displayColor (M2). Orthographic camera looking down -Z,
# 20 x 20 world units on 200 x 200 pixels: pixel (x, y) (EXR, y down) sees
#   X = -10 + (x + 0.5) / 10,   Y = 10 - (y + 0.5) / 10.
# Every card is a unit square in z = 0. The albedo AOV must show:
#   PI:      per-instance colors (vertex primvar on the PointInstancer)
#   PIown:   the prototype's own color (the closer primvar wins)
#   NI_*:    constant colors authored on native-instance prims
#   Outer:   nested instancers; the outer level's colors reach the inner instances
#   Outer2:  nested instancers with colors on both levels; the inner level wins
def Xform "World"
{
    def PointInstancer "PI"
    {
        rel prototypes = [</World/PI/Protos/Sq>]
        int[] protoIndices = [0, 0, 0]
        point3f[] positions = [(-6, 6, 0), (-4, 6, 0), (-2, 6, 0)]
        color3f[] primvars:displayColor = [(1, 0, 0), (0, 1, 0), (0, 0, 1)] (
            interpolation = "vertex"
        )

        def Scope "Protos"
        {
            def Mesh "Sq"
            {
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                point3f[] points = [(-0.5, -0.5, 0), (0.5, -0.5, 0), (0.5, 0.5, 0), (-0.5, 0.5, 0)]
                uniform token subdivisionScheme = "none"
            }
        }
    }

    def PointInstancer "PIown"
    {
        rel prototypes = [</World/PIown/Protos/Sq>]
        int[] protoIndices = [0, 0]
        point3f[] positions = [(2, 6, 0), (4, 6, 0)]
        color3f[] primvars:displayColor = [(1, 0, 0), (0, 1, 0)] (
            interpolation = "vertex"
        )

        def Scope "Protos"
        {
            def Mesh "Sq"
            {
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                point3f[] points = [(-0.5, -0.5, 0), (0.5, -0.5, 0), (0.5, 0.5, 0), (-0.5, 0.5, 0)]
                uniform token subdivisionScheme = "none"
                color3f[] primvars:displayColor = [(0.8, 0.4, 0.1)]
            }
        }
    }

    def Xform "NI_C" (
        instanceable = true
        references = </ColorProto>
    )
    {
        double3 xformOp:translate = (-6, 2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(1, 1, 0)]
    }

    def Xform "NI_D" (
        instanceable = true
        references = </ColorProto>
    )
    {
        double3 xformOp:translate = (-4, 2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0, 1, 1)]
    }

    def PointInstancer "Outer"
    {
        rel prototypes = [</World/Outer/Protos/Row>]
        int[] protoIndices = [0, 0]
        point3f[] positions = [(-6, -2, 0), (-6, -5, 0)]
        color3f[] primvars:displayColor = [(1, 0, 0), (0, 0, 1)] (
            interpolation = "vertex"
        )

        def Scope "Protos"
        {
            def Xform "Row"
            {
                def PointInstancer "inner"
                {
                    rel prototypes = [</World/Outer/Protos/Row/inner/Protos/Sq>]
                    int[] protoIndices = [0, 0]
                    point3f[] positions = [(0, 0, 0), (2, 0, 0)]

                    def Scope "Protos"
                    {
                        def Mesh "Sq"
                        {
                            int[] faceVertexCounts = [4]
                            int[] faceVertexIndices = [0, 1, 2, 3]
                            point3f[] points = [(-0.5, -0.5, 0), (0.5, -0.5, 0), (0.5, 0.5, 0), (-0.5, 0.5, 0)]
                            uniform token subdivisionScheme = "none"
                        }
                    }
                }
            }
        }
    }

    def PointInstancer "Outer2"
    {
        rel prototypes = [</World/Outer2/Protos/Row>]
        int[] protoIndices = [0, 0]
        point3f[] positions = [(2, -2, 0), (2, -5, 0)]
        color3f[] primvars:displayColor = [(1, 0, 0), (0, 0, 1)] (
            interpolation = "vertex"
        )

        def Scope "Protos"
        {
            def Xform "Row"
            {
                def PointInstancer "inner"
                {
                    rel prototypes = [</World/Outer2/Protos/Row/inner/Protos/Sq>]
                    int[] protoIndices = [0, 0]
                    point3f[] positions = [(0, 0, 0), (2, 0, 0)]
                    color3f[] primvars:displayColor = [(0, 1, 0), (1, 1, 0)] (
                        interpolation = "vertex"
                    )

                    def Scope "Protos"
                    {
                        def Mesh "Sq"
                        {
                            int[] faceVertexCounts = [4]
                            int[] faceVertexIndices = [0, 1, 2, 3]
                            point3f[] points = [(-0.5, -0.5, 0), (0.5, -0.5, 0), (0.5, 0.5, 0), (-0.5, 0.5, 0)]
                            uniform token subdivisionScheme = "none"
                        }
                    }
                }
            }
        }
    }

    def DomeLight "sky"
    {
        float inputs:intensity = 1
    }

    def Camera "cam"
    {
        token projection = "orthographic"
        float horizontalAperture = 200
        float verticalAperture = 200
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

class Xform "ColorProto"
{
    def Mesh "geo"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.5, -0.5, 0), (0.5, -0.5, 0), (0.5, 0.5, 0), (-0.5, 0.5, 0)]
        uniform token subdivisionScheme = "none"
    }
}

def Scope "Render"
{
    def RenderSettings "settings"
    {
        rel camera = </World/cam>
        int2 resolution = (200, 200)
        rel products = </Render/Products/aovs>
        int nova:samples = 4
        int nova:maxDepth = 1
    }

    def Scope "Products"
    {
        def RenderProduct "aovs"
        {
            token productName = "instancing_colors.exr"
            token productType = "raster"
            rel orderedVars = [
                </Render/Vars/color>,
                </Render/Vars/albedo>,
            ]
        }
    }

    def Scope "Vars"
    {
        def RenderVar "color" (
            prepend apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            string driver:parameters:aov:husk:name = "C"
            uniform string sourceName = "color"
            uniform token sourceType = "raw"
            uniform token dataType = "color4f"
        }
        def RenderVar "albedo" (
            prepend apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            string driver:parameters:aov:husk:name = "albedo"
            uniform string sourceName = "albedo"
            uniform token sourceType = "raw"
            uniform token dataType = "color3f"
        }
    }
}
