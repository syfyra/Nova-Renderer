#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 2
)

# nova:subdivMaxTriangles drops from 1e6 to 500 at frame 2
# (tests/husk/check_render_pass.py): only /World/big changes its tessellation
# rate (8 -> 4: 768 triangles exceed the budget); /World/small (rate 4, 192
# triangles) and the polygon mesh /World/poly must not be rebuilt, although
# the display-style resync re-dirties their topology and points.
def Xform "World"
{
    def Mesh "small"
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2, 2, 3, 5, 4, 4, 5, 7, 6, 6, 7, 1, 0, 1, 7, 5, 3, 6, 0, 2, 4]
        point3f[] points = [(-3, -1, 1), (-1, -1, 1), (-3, 1, 1), (-1, 1, 1), (-3, 1, -1), (-1, 1, -1), (-3, -1, -1), (-1, -1, -1)]
        uniform token subdivisionScheme = "catmullClark"
    }
    def Mesh "big"
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2, 2, 3, 5, 4, 4, 5, 7, 6, 6, 7, 1, 0, 1, 7, 5, 3, 6, 0, 2, 4]
        point3f[] points = [(1, -1, 1), (3, -1, 1), (1, 1, 1), (3, 1, 1), (1, 1, -1), (3, 1, -1), (1, -1, -1), (3, -1, -1)]
        uniform token subdivisionScheme = "catmullClark"
        int primvars:nova:subdivLevel = 3 (interpolation = "constant")
    }

    def Mesh "poly"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-5, -3, 0), (5, -3, 0), (5, -2, 0), (-5, -2, 0)]
        uniform token subdivisionScheme = "none"
    }

    def DomeLight "sky"
    {
        float inputs:intensity = 1
    }

    def Camera "cam"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 36
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

def Scope "Render"
{
    def RenderSettings "settings"
    {
        rel camera = </World/cam>
        int2 resolution = (64, 64)
        int nova:samples = 4
        int nova:maxDepth = 1
        int nova:subdivLevel = 2
        int nova:subdivMaxTriangles.timeSamples = {
            1: 1000000,
            2: 500,
        }
    }
}
