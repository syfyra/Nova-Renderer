{
    def Scope "Looks"
    {
        def Material "n_noise2d"
        {
            token outputs:mtlx:surface.connect = </World/Looks/n_noise2d/surface.outputs:out>
            def Shader "surface"
            {
                uniform token info:id = "ND_surface_unlit"
                color3f inputs:emission_color.connect = </World/Looks/n_noise2d/out.outputs:out>
                token outputs:out
            }
            def Shader "st"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }
            def Shader "tc"
            {
                uniform token info:id = "ND_multiply_vector2FA"
                float2 inputs:in1.connect = </World/Looks/n_noise2d/st.outputs:out>
                float inputs:in2 = 4
                float2 outputs:out
            }
            def Shader "out"
            {
                uniform token info:id = "ND_noise2d_color3"
                float2 inputs:texcoord.connect = </World/Looks/n_noise2d/tc.outputs:out>
                float3 inputs:amplitude = (0.5, 0.5, 0.5)
                float inputs:pivot = 0.5
                color3f outputs:out
            }
        }
