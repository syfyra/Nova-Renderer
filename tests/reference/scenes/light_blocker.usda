#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    subLayers = [@./common.usda@]
)

def Xform "World"
{
    def Mesh "ground" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-20, 0, 20), (20, 0, 20), (20, 0, -20), (-20, 0, -20)]
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        color3f[] primvars:displayColor = [(0.6, 0.6, 0.6)]
        rel material:binding = </Looks/displayColorLambert>
    }
    def Mesh "wall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-6, 0, -2.5), (6, 0, -2.5), (6, 4, -2.5), (-6, 4, -2.5)]
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        color3f[] primvars:displayColor = [(0.7, 0.7, 0.7)]
        rel material:binding = </Looks/displayColorLambert>
    }
    def Mesh "ballL" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./assets/sphere.usda@
    )
    {
        color3f[] primvars:displayColor = [(0.8, 0.35, 0.25)]
        rel material:binding = </Looks/displayColorLambert>
        double3 xformOp:translate = (-1.3, 0.5, 0)
        double3 xformOp:scale = (0.5, 0.5, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Mesh "ballM" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./assets/sphere.usda@
    )
    {
        color3f[] primvars:displayColor = [(0.75, 0.75, 0.75)]
        rel material:binding = </Looks/displayColorLambert>
        double3 xformOp:translate = (0, 0.5, -0.6)
        double3 xformOp:scale = (0.5, 0.5, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Mesh "ballR" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./assets/sphere.usda@
    )
    {
        color3f[] primvars:displayColor = [(0.25, 0.4, 0.8)]
        rel material:binding = </Looks/displayColorLambert>
        double3 xformOp:translate = (1.3, 0.5, 0)
        double3 xformOp:scale = (0.5, 0.5, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Camera "cam"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 21.6
        float2 clippingRange = (0.01, 10000)
        double3 xformOp:translate = (0, 1.4, 5.2)
        float3 xformOp:rotateXYZ = (-10, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def RectLight "key"
    {
        float inputs:intensity = 6
        float inputs:width = 1.5
        float inputs:height = 1.0
        rel light:filters = [</World/blkBox>, </World/blkBall>]
        double3 xformOp:translate = (1.2, 3, 2)
        float3 xformOp:rotateXYZ = (-60, 25, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def SphereLight "fill"
    {
        float inputs:intensity = 2
        float inputs:radius = 0.3
        double3 xformOp:translate = (-2.5, 2, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def LightFilter "blkBox"
    {
        uniform token lightFilter:shaderId = "kma_lfilter_blocker"
        uniform token kma:lightFilter:shaderId = "kma_lfilter_blocker"
        token inputs:shape = "box"
        float inputs:width = 1.6
        float inputs:height = 1.4
        float inputs:depth = 1.0
        float inputs:roundedcorner = 0.4
        float inputs:falloff = 0.3
        float inputs:intensity = 0.15
        float inputs:exposure = 0
        color3f inputs:tint = (1, 0.6, 0.3)
        int inputs:invert = 0
        float inputs:radius = 0.5
        string inputs:space = "/World/blkBox"
        double3 xformOp:translate = (1.1, 0.4, 0.4)
        float3 xformOp:rotateXYZ = (0, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def LightFilter "blkBall"
    {
        uniform token lightFilter:shaderId = "kma_lfilter_blocker"
        uniform token kma:lightFilter:shaderId = "kma_lfilter_blocker"
        token inputs:shape = "sphere"
        float inputs:radius = 2.2
        float inputs:falloff = 0.4
        float inputs:intensity = 0.25
        float inputs:exposure = 0
        color3f inputs:tint = (1, 1, 1)
        int inputs:invert = 1
        string inputs:space = "/World/blkBall"
        double3 xformOp:translate = (-0.4, 0.5, -0.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

def Scope "Render"
{
    def RenderSettings "ref" (
        inherits = </_class_RefSettings>
    )
    {
        rel camera = </World/cam>
        int2 resolution = (160, 96)
        float nova:object:diffuseLimit = 3
        float karma:object:diffuselimit = 3
    }
}
