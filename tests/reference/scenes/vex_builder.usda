#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    subLayers = [@./common.usda@]
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "vb_plastic"
        {
            token outputs:vex:surface.connect = </World/Looks/vb_plastic/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:implementationSource = "sourceCode"
                string info:sourceCode = "#include \"bsdf.h\"\n\nsurface\nvb_plastic(vector tint = {0.7, 0.3, 0.2}; float rough = 0.3; float freq = 3)\n{\n    vector nn = frontface(normalize(N), I);\n    vector ng = frontface(normalize(Ng), I);\n    vector base = tint * (0.4 + 0.6 * noise(P * freq));\n    float energy = 0;\n    bsdf spec = get_bsdf(\"ggx\", ng, nn, normalize(I), normalize(dPds), normalize(dPdt), {1, 1, 1}, {1, 1, 1},\n                         1.0 / 1.5, rough, 0, 0, 1, 0, 1, 1, 0, 0, energy, \"reflect\", \"refract\");\n    F = 2.0 * diffuse(nn, \"label\", \"diffuse\") * base + spec;\n}\n"
                token outputs:surface
            }
        }
        def Material "vb_metal"
        {
            token outputs:vex:surface.connect = </World/Looks/vb_metal/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:implementationSource = "sourceCode"
                string info:sourceCode = "#include \"bsdf.h\"\n\nsurface\nvb_metal(vector color = {0.95, 0.64, 0.54}; float rough = 0.25)\n{\n    vector nn = frontface(normalize(N), I);\n    vector ng = frontface(normalize(Ng), I);\n    float energy = 0;\n    F = get_bsdf(\"ggx\", ng, nn, normalize(I), normalize(dPds), normalize(dPdt), color, {1, 1, 1},\n                 1.0 / 1.5, rough, 0, 0, 1, 0, 0, 1, 0, 0, energy, \"reflect\", \"refract\");\n}\n"
                token outputs:surface
            }
        }
        def Material "vb_texture"
        {
            token outputs:vex:surface.connect = </World/Looks/vb_texture/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:implementationSource = "sourceCode"
                string info:sourceCode = "surface\nvb_texture(string map = \"\"; vector2 st = {0, 0})\n{\n    vector nn = frontface(normalize(N), I);\n    vector c = texture(map, st.x, st.y);\n    F = 2.0 * diffuse(nn, \"label\", \"diffuse\") * c;\n}\n"
                asset inputs:map = @./assets/normal_checks.png@
                token outputs:surface
            }
        }
        def Material "vb_primvar"
        {
            token outputs:vex:surface.connect = </World/Looks/vb_primvar/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:implementationSource = "sourceCode"
                string info:sourceCode = "surface\nvb_primvar(vector tint = {1, 0, 1})\n{\n    vector nn = frontface(normalize(N), I);\n    F = 2.0 * diffuse(nn, \"label\", \"diffuse\") * tint;\n}\n"
                token outputs:surface
            }
        }
        def Material "vb_layered"
        {
            token outputs:vex:surface.connect = </World/Looks/vb_layered/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:implementationSource = "sourceCode"
                string info:sourceCode = "#include <shaderlayer.h>\n\nsurface\nvb_layered(vector tint = {0.2, 0.4, 0.8})\n{\n    ShaderLayer layer;\n    init_layer(layer);\n    vector nn = frontface(normalize(N), I);\n    layer.F = 2.0 * diffuse(nn, \"label\", \"diffuse\") * tint;\n    F = layer.F;\n    Of = layer.Of;\n}\n"
                token outputs:surface
            }
        }
        def Material "vb_roughnoise"
        {
            token outputs:vex:surface.connect = </World/Looks/vb_roughnoise/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:implementationSource = "sourceCode"
                string info:sourceCode = "#include \"bsdf.h\"\n\nsurface\nvb_roughnoise(vector color = {0.9, 0.9, 0.9}; float freq = 2)\n{\n    vector nn = frontface(normalize(N), I);\n    vector ng = frontface(normalize(Ng), I);\n    float rough = 0.1 + 0.5 * noise(P * freq);\n    float energy = 0;\n    F = get_bsdf(\"ggx\", ng, nn, normalize(I), normalize(dPds), normalize(dPdt), color, {1, 1, 1},\n                 1.0 / 1.5, rough, 0, 0, 1, 0, 0, 1, 0, 0, energy, \"reflect\", \"refract\");\n}\n"
                token outputs:surface
            }
        }
        def Material "vb_displaced"
        {
            token outputs:vex:surface.connect = </World/Looks/vb_displaced/surface.outputs:surface>
            token outputs:vex:displacement.connect = </World/Looks/vb_displaced/displace.outputs:displacement>
            def Shader "surface"
            {
                uniform token info:implementationSource = "sourceCode"
                string info:sourceCode = "surface\nvb_displaced(vector tint = {0.6, 0.55, 0.4})\n{\n    vector nn = frontface(normalize(N), I);\n    F = 2.0 * diffuse(nn, \"label\", \"diffuse\") * tint;\n}\n"
                token outputs:surface
            }
            def Shader "displace"
            {
                uniform token info:implementationSource = "sourceCode"
                string info:sourceCode = "displace\nvb_bumps(float amp = 0.04; float freq = 3)\n{\n    P += normalize(N) * amp * (2 * noise(P * freq) - 1);\n    N = computenormal(P);\n}\n"
                float inputs:amp = 0.05
                token outputs:displacement
            }
        }
    }
    def Mesh "ball_vb_plastic" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./assets/sphere.usda@
    )
    {
        rel material:binding = </World/Looks/vb_plastic>
        double3 xformOp:translate = (-1.5, 0.55, 0)
        double3 xformOp:scale = (0.42, 0.42, 0.42)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Mesh "ball_vb_metal" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./assets/sphere.usda@
    )
    {
        rel material:binding = </World/Looks/vb_metal>
        double3 xformOp:translate = (-0.5, 0.55, 0)
        double3 xformOp:scale = (0.42, 0.42, 0.42)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Mesh "ball_vb_texture" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./assets/sphere_st.usda@
    )
    {
        rel material:binding = </World/Looks/vb_texture>
        double3 xformOp:translate = (0.5, 0.55, 0)
        double3 xformOp:scale = (0.42, 0.42, 0.42)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Mesh "ball_vb_primvar" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./assets/sphere.usda@
    )
    {
