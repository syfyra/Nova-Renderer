#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    subLayers = [@./common.usda@]
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "kma_plastic"
        {
            token outputs:kma:surface.connect = </World/Looks/kma_plastic/surface.outputs:out>
            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.1, 0.4, 0.7)
                float inputs:specular_roughness = 0.3
                token outputs:out
            }
        }
        def Material "kma_metal"
        {
            token outputs:kma:surface.connect = </World/Looks/kma_metal/surface.outputs:out>
            def Shader "surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.95, 0.64, 0.54)
                float inputs:base_metalness = 1
                float inputs:specular_roughness = 0.25
                token outputs:out
            }
        }
        def Material "kma_diffuse"
        {
            token outputs:kma:surface.connect = </World/Looks/kma_diffuse/surface.outputs:out>
            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.8, 0.2, 0.2)
                float inputs:specular = 0
                token outputs:out
            }
        }
    }
    def Mesh "ball_kma_plastic" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./assets/sphere.usda@
    )
    {
        rel material:binding = </World/Looks/kma_plastic>
        double3 xformOp:translate = (-1.1, 0, 0)
        double3 xformOp:scale = (0.48, 0.48, 0.48)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Mesh "ball_kma_metal" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./assets/sphere.usda@
    )
    {
        rel material:binding = </World/Looks/kma_metal>
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:scale = (0.48, 0.48, 0.48)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Mesh "ball_kma_diffuse" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./assets/sphere.usda@
    )
    {
        rel material:binding = </World/Looks/kma_diffuse>
        double3 xformOp:translate = (1.1, 0, 0)
        double3 xformOp:scale = (0.48, 0.48, 0.48)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def DomeLight "sky"
    {
        float inputs:intensity = 1
        asset inputs:texture:file = @./assets/sky_soft.exr@
        token inputs:texture:format = "latlong"
        float inputs:karma:light:misbias = -1
        bool inputs:karma:light:renderlightgeo = 1
        uniform token[] xformOpOrder = []
    }
    def Camera "cam"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 18
        float2 clippingRange = (0.01, 10000)
        double3 xformOp:translate = (0, 0, 4)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}

def Scope "Render"
{
    def RenderSettings "ref" (
        inherits = </_class_RefSettings>
    )
    {
        rel camera = </World/cam>
        int2 resolution = (160, 80)
        float nova:object:diffuseLimit = 0
        float nova:object:reflectLimit = 0
        float nova:object:refractLimit = 0
        float karma:object:diffuselimit = 0
        float karma:object:reflectlimit = 0
        float karma:object:refractlimit = 0
    }
}
