#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    subLayers = [@./common.usda@]
)

def Xform "World"
{
    def Mesh "ground" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1000, 0, 1000), (1000, 0, 1000), (1000, 0, -1000), (-1000, 0, -1000)]
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        rel material:binding = </Looks/displayColorLambert>
    }
    def DomeLight "sky"
    {
        float inputs:intensity = 1
        asset inputs:texture:file = @./assets/sky_soft.exr@
        token inputs:texture:format = "latlong"
        float inputs:karma:light:misbias = -1
        uniform token[] xformOpOrder = []
    }
    def Camera "cam"
    {
        float focalLength = 50
        float horizontalAperture = 20
        float verticalAperture = 20
        float2 clippingRange = (0.01, 10000)
        double3 xformOp:translate = (0, 10, 0)
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}

def Scope "Render"
{
    def RenderSettings "ref" (
        inherits = </_class_RefSettings>
    )
    {
        rel camera = </World/cam>
        int2 resolution = (32, 32)
        float nova:object:diffuseLimit = 0
        float karma:object:diffuselimit = 0
    }
}
