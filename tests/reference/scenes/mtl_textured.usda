#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    subLayers = [@./common.usda@]
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "udim"
        {
            token outputs:mtlx:surface.connect = </World/Looks/udim/surface.outputs:out>
            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color.connect = </World/Looks/udim/img.outputs:out>
                float inputs:specular_roughness = 0.5
                token outputs:out
            }
            def Shader "img"
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @./assets/udim_base.<UDIM>.png@
                color3f outputs:out
            }
        }
        def Material "rough_metal"
        {
            token outputs:mtlx:surface.connect = </World/Looks/rough_metal/surface.outputs:out>
            def Shader "surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.95, 0.64, 0.54)
                float inputs:base_metalness = 1
                float inputs:specular_roughness.connect = </World/Looks/rough_metal/rough.outputs:out>
                token outputs:out
            }
            def Shader "rough"
            {
                uniform token info:id = "ND_image_float"
                asset inputs:file = @./assets/rough.png@
                float outputs:out
            }
        }
        def Material "raw_diffuse"
        {
            token outputs:mtlx:surface.connect = </World/Looks/raw_diffuse/surface.outputs:out>
            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base.connect = </World/Looks/raw_diffuse/map.outputs:out>
                color3f inputs:base_color = (1, 1, 1)
                float inputs:specular = 0
                token outputs:out
            }
            def Shader "map"
            {
                uniform token info:id = "ND_image_float"
                asset inputs:file = @./assets/rough.png@
                float outputs:out
            }
        }
        def Material "ground"
        {
            token outputs:mtlx:surface.connect = </World/Looks/ground/surface.outputs:out>
            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color.connect = </World/Looks/ground/chk.outputs:out>
                float inputs:specular = 0
                token outputs:out
            }
            def Shader "chk"
            {
                uniform token info:id = "ND_tiledimage_color3"
                asset inputs:file = @./assets/checker_lin.exr@
                float2 inputs:uvtiling = (8, 32)
                color3f outputs:out
            }
        }
    }
    def Mesh "ground" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-4, 0, 2), (4, 0, 2), (4, 0, -30), (-4, 0, -30)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        rel material:binding = </World/Looks/ground>
    }
    def Mesh "udim_card" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-2.3, 0.15, -0.5), (-0.7, 0.15, -0.5), (-0.7, 0.95, -0.5), (-2.3, 0.95, -0.5)]
        texCoord2f[] primvars:st = [(0, 0), (2, 0), (2, 1), (0, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        rel material:binding = </World/Looks/udim>
    }
    def Mesh "raw_card" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.45, 0.1, -1.2), (0.35, 0.1, -1.2), (0.35, 0.6, -1.2), (-0.45, 0.6, -1.2)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        rel material:binding = </World/Looks/raw_diffuse>
    }
    def Mesh "ball" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./assets/sphere_st.usda@
    )
    {
        rel material:binding = </World/Looks/rough_metal>
        double3 xformOp:translate = (1.2, 0.55, -0.5)
        double3 xformOp:scale = (0.5, 0.5, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def DomeLight "sky"
    {
        float inputs:intensity = 1
        asset inputs:texture:file = @./assets/sky_soft.exr@
        token inputs:texture:format = "latlong"
        float inputs:karma:light:misbias = -1
        bool inputs:karma:light:renderlightgeo = 1
        uniform token[] xformOpOrder = []
    }
    def RectLight "key"
    {
        float inputs:intensity = 4
        float inputs:width = 2
        float inputs:height = 2
        double3 xformOp:translate = (2, 3, 2)
        float3 xformOp:rotateXYZ = (-50, 35, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Camera "cam"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 18
        float2 clippingRange = (0.01, 10000)
        double3 xformOp:translate = (0, 1, 3.2)
        float3 xformOp:rotateXYZ = (-9, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}

def Scope "Render"
{
    def RenderSettings "ref" (
        inherits = </_class_RefSettings>
    )
    {
        rel camera = </World/cam>
        int2 resolution = (192, 96)
        float nova:object:diffuseLimit = 0
        float nova:object:reflectLimit = 0
        float nova:object:refractLimit = 0
        float karma:object:diffuselimit = 0
        float karma:object:reflectlimit = 0
        float karma:object:refractlimit = 0
    }
}
