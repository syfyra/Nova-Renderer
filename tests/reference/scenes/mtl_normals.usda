#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    subLayers = [@./common.usda@]
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "nmap"
        {
            token outputs:mtlx:surface.connect = </World/Looks/nmap/surface.outputs:out>
            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.7, 0.7, 0.7)
                float inputs:specular = 0
                float3 inputs:normal.connect = </World/Looks/nmap/nm.outputs:out>
                token outputs:out
            }
            def Shader "img"
            {
                uniform token info:id = "ND_image_vector3"
                asset inputs:file = @./assets/normal_checks.png@
                float3 outputs:out
            }
            def Shader "nm"
            {
                uniform token info:id = "ND_normalmap_float"
                float3 inputs:in.connect = </World/Looks/nmap/img.outputs:out>
                float3 outputs:out
            }
        }
        def Material "bumped"
        {
            token outputs:mtlx:surface.connect = </World/Looks/bumped/surface.outputs:out>
            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.6, 0.65, 0.7)
                float inputs:specular = 0
                float3 inputs:normal.connect = </World/Looks/bumped/bmp.outputs:out>
                token outputs:out
            }
            def Shader "st"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }
            def Shader "tc"
            {
                uniform token info:id = "ND_multiply_vector2FA"
                float2 inputs:in1.connect = </World/Looks/bumped/st.outputs:out>
                float inputs:in2 = 6
                float2 outputs:out
            }
            def Shader "h"
            {
                uniform token info:id = "ND_noise2d_float"
                float2 inputs:texcoord.connect = </World/Looks/bumped/tc.outputs:out>
                float inputs:amplitude = 0.5
                float outputs:out
            }
            def Shader "bmp"
            {
                uniform token info:id = "ND_bump_vector3"
                float inputs:height.connect = </World/Looks/bumped/h.outputs:out>
                float inputs:scale = 0.08
                float3 outputs:out
            }
        }
        def Material "aniso"
        {
            token outputs:mtlx:surface.connect = </World/Looks/aniso/surface.outputs:out>
            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.9, 0.9, 0.9)
                float inputs:metalness = 1
                float inputs:specular_roughness = 0.35
                float inputs:specular_anisotropy = 0.8
                token outputs:out
            }
        }
        def Material "aniso_rot"
        {
            token outputs:mtlx:surface.connect = </World/Looks/aniso_rot/surface.outputs:out>
            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.9, 0.9, 0.9)
                float inputs:metalness = 1
                float inputs:specular_roughness = 0.35
                float inputs:specular_anisotropy = 0.8
                float inputs:specular_rotation = 0.125
                token outputs:out
            }
        }
    }
    def Mesh "ground" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-6, 0, 3), (6, 0, 3), (6, 0, -6), (-6, 0, -6)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        rel material:binding = </World/Looks/bumped>
    }
    def Mesh "ball" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./assets/sphere_st.usda@
    )
    {
        rel material:binding = </World/Looks/nmap>
        double3 xformOp:translate = (-1.4, 0.6, -0.5)
        double3 xformOp:scale = (0.55, 0.55, 0.55)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Mesh "aniso_st" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(0.2, 0.15, -0.6), (1, 0.15, -0.6), (1, 0.95, -0.6), (0.2, 0.95, -0.6)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        rel material:binding = </World/Looks/aniso>
    }
    def Mesh "aniso_swapped" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(1.2, 0.15, -0.6), (2, 0.15, -0.6), (2, 0.95, -0.6), (1.2, 0.95, -0.6)]
        texCoord2f[] primvars:st = [(0, 0), (0, 1), (1, 1), (1, 0)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        rel material:binding = </World/Looks/aniso>
    }
    def Mesh "aniso_rotated" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.8, 0.15, -0.9), (0, 0.15, -0.9), (0, 0.95, -0.9), (-0.8, 0.95, -0.9)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        rel material:binding = </World/Looks/aniso_rot>
    }
    def DomeLight "sky"
    {
        float inputs:intensity = 1
        asset inputs:texture:file = @./assets/sky_soft.exr@
        token inputs:texture:format = "latlong"
        float inputs:karma:light:misbias = -1
        bool inputs:karma:light:renderlightgeo = 1
        uniform token[] xformOpOrder = []
    }
    def RectLight "key"
    {
        float inputs:intensity = 6
        float inputs:width = 1
        float inputs:height = 1
        double3 xformOp:translate = (0.8, 2.2, 2.5)
        float3 xformOp:rotateXYZ = (-35, 10, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Camera "cam"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 18
        float2 clippingRange = (0.01, 10000)
        double3 xformOp:translate = (0, 1, 3.2)
        float3 xformOp:rotateXYZ = (-9, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}

def Scope "Render"
{
    def RenderSettings "ref" (
        inherits = </_class_RefSettings>
    )
    {
        rel camera = </World/cam>
        int2 resolution = (192, 96)
        float nova:object:diffuseLimit = 0
        float nova:object:reflectLimit = 0
        float nova:object:refractLimit = 0
        float karma:object:diffuselimit = 0
        float karma:object:reflectlimit = 0
        float karma:object:refractlimit = 0
    }
}
