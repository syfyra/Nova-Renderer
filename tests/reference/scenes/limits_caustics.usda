#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    subLayers = [@./common.usda@]
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "glass"
        {
            token outputs:mtlx:surface.connect = </World/Looks/glass/surface.outputs:out>
            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 0
                float inputs:transmission = 1
                float inputs:specular_roughness = 0
                token outputs:out
            }
        }
        def Material "mirror"
        {
            token outputs:mtlx:surface.connect = </World/Looks/mirror/surface.outputs:out>
            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.9, 0.9, 0.9)
                float inputs:metalness = 1
                float inputs:specular_roughness = 0
                token outputs:out
            }
        }
    }
    def Mesh "floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-6, 0, 6), (6, 0, 6), (6, 0, -6), (-6, 0, -6)]
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        color3f[] primvars:displayColor = [(0.6, 0.6, 0.6)]
        rel material:binding = </Looks/displayColorLambert>
    }
    def Mesh "ball" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./assets/sphere.usda@
    )
    {
        bool primvars:nova:object:fakeCaustics = 1 (interpolation = "constant")
        bool primvars:karma:object:causticsenable = 0 (interpolation = "constant")
        rel material:binding = </World/Looks/glass>
        double3 xformOp:translate = (0.9, 0.55, 0.3)
        double3 xformOp:scale = (0.5, 0.5, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Mesh "mirrorL" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.8, 0, 0), (0.8, 0, 0), (0.8, 1.4, 0), (-0.8, 1.4, 0)]
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        rel material:binding = </World/Looks/mirror>
        double3 xformOp:translate = (-2.0, 0, -0.6)
        float3 xformOp:rotateXYZ = (0, 55, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Mesh "mirrorR" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.8, 0, 0), (0.8, 0, 0), (0.8, 1.4, 0), (-0.8, 1.4, 0)]
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        rel material:binding = </World/Looks/mirror>
        double3 xformOp:translate = (-0.2, 0, -0.6)
        float3 xformOp:rotateXYZ = (0, -55, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Mesh "orb" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./assets/sphere.usda@
    )
    {
        color3f[] primvars:displayColor = [(0.8, 0.3, 0.2)]
        rel material:binding = </Looks/displayColorLambert>
        double3 xformOp:translate = (-1.1, 0.3, -0.6)
        double3 xformOp:scale = (0.3, 0.3, 0.3)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def DomeLight "sky"
    {
        float inputs:intensity = 0.3
        uniform token[] xformOpOrder = []
    }
    def RectLight "key"
    {
        float inputs:intensity = 1.2
        float inputs:width = 3
        float inputs:height = 3
        double3 xformOp:translate = (0.9, 4, 0.3)
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Camera "cam"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 21.6
        float2 clippingRange = (0.01, 10000)
        double3 xformOp:translate = (0, 2.4, 4.2)
        float3 xformOp:rotateXYZ = (-25, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}

def Scope "Render"
{
    def RenderSettings "ref" (
        inherits = </_class_RefSettings>
    )
    {
        rel camera = </World/cam>
        int2 resolution = (160, 96)
        float nova:object:diffuseLimit = 1
        float nova:object:reflectLimit = 2
        float nova:object:refractLimit = 4
        float karma:object:diffuselimit = 1
        float karma:object:reflectlimit = 2
        float karma:object:refractlimit = 4
    }
}
