#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    timeCodesPerSecond = 24
)

# The indirect-heavy scene of tests/husk/check_karma_guiding.py
# (docs/design/M11-P9c.md): a closed grey room (6 x 3 x 6) lit only by a sun
# through a 1.2 x 1 window in its +x wall. The sun lights a patch of the floor
# near the window; everything else the camera sees is lit by light bounced
# off that patch, which paths without guiding rarely find.
def Xform "World"
{
    def Mesh "room" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        # Floor, ceiling, the -x, -z and +z walls, and the +x wall as four
        # pieces around the window (y 1.2..2.2, z -0.6..0.6); shared corner
        # points keep the box watertight.
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [
            0, 3, 2, 1,
            4, 5, 6, 7,
            0, 4, 7, 3,
            0, 1, 5, 4,
            3, 7, 6, 2,
            1, 2, 9, 8,
            12, 13, 6, 5,
            8, 10, 12, 5,
            11, 9, 6, 13
        ]
        point3f[] points = [
            (-3, 0, -3), (3, 0, -3), (3, 0, 3), (-3, 0, 3),
            (-3, 3, -3), (3, 3, -3), (3, 3, 3), (-3, 3, 3),
            (3, 1.2, -3), (3, 1.2, 3), (3, 1.2, -0.6), (3, 1.2, 0.6),
            (3, 2.2, -0.6), (3, 2.2, 0.6)
        ]
        float3[] extent = [(-3, 0, -3), (3, 3, 3)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Looks/grey>
    }
    def Mesh "sill" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        # The window's reveal: the four faces of the 0.1 thick opening.
        int[] faceVertexCounts = [4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 2, 3, 4, 7, 6, 5, 0, 4, 5, 1, 3, 2, 6, 7]
        point3f[] points = [
            (3, 1.2, -0.6), (3.1, 1.2, -0.6), (3.1, 1.2, 0.6), (3, 1.2, 0.6),
            (3, 2.2, -0.6), (3.1, 2.2, -0.6), (3.1, 2.2, 0.6), (3, 2.2, 0.6)
        ]
        float3[] extent = [(3, 1.2, -0.6), (3.1, 2.2, 0.6)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Looks/grey>
    }
    def Camera "cam"
    {
        float focalLength = 16
        float horizontalAperture = 36
        float verticalAperture = 27
        float2 clippingRange = (0.01, 10000)
        double3 xformOp:translate = (2.6, 1.6, 2.6)
        float3 xformOp:rotateXYZ = (-6, 50, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}

def DistantLight "sun"
{
    float inputs:intensity = 6
    float inputs:angle = 0
    float3 xformOp:rotateXYZ = (0, 90, 0)
    float3 xformOp:rotateXYZ:tilt = (-45, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ", "xformOp:rotateXYZ:tilt"]
}

def Scope "Looks"
{
    def Material "grey"
    {
        token outputs:mtlx:surface.connect = </Looks/grey/s.outputs:out>
        def Shader "s"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.7, 0.7, 0.7)
            float inputs:specular = 0
            token outputs:out
        }
    }
}
