#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    timeCodesPerSecond = 24
)

# The edge of tests/husk/check_karma_looks.py (docs/design/M11-P9a.md): a
# camera at the origin looking down -Z (focal 50, aperture 36 x 27, 320 x 240:
# 0.00225 tan per pixel at the centre) sees an emissive card on the left half
# at z = -5 in front of an emissive backdrop at z = -10. The edge is at
# column 160.
def Xform "World"
{
    def Mesh "front" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-10, -10, -5), (0, -10, -5), (0, 10, -5), (-10, 10, -5)]
        float3[] extent = [(-10, -10, -5), (0, 10, -5)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Looks/front>
    }
    def Mesh "back" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-40, -40, -10), (40, -40, -10), (40, 40, -10), (-40, 40, -10)]
        float3[] extent = [(-40, -40, -10), (40, 40, -10)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Looks/back>
    }
    def Camera "cam"
    {
        float focalLength = 50
        float horizontalAperture = 36
        float verticalAperture = 27
        float2 clippingRange = (0.01, 10000)
    }
}

def Scope "Looks"
{
    def Material "front"
    {
        token outputs:mtlx:surface.connect = </Looks/front/s.outputs:out>
        def Shader "s"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color = (0.2, 0.4, 0.6)
            token outputs:out
        }
    }
    def Material "back"
    {
        token outputs:mtlx:surface.connect = </Looks/back/s.outputs:out>
        def Shader "s"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color = (0.1, 0.1, 0.1)
            token outputs:out
        }
    }
}
