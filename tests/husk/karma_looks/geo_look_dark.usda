#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    timeCodesPerSecond = 24
)

# The look-dev scene of tests/husk/check_karma_looks.py (docs/design/M11-P9a.md):
# the camera of geo_edge.usda sees five cards at z = -8 (x = -2.4 ... 2.4,
# turned by 0, 30, 45, 60 and 75 degrees about Y), a floor at y = -2, a wall
# at z = -12 and an emissive panel; every surface has a display colour
# (0.8, 0.5, 0.2; the panel's (0.1, 0.9, 0.1)) and a blue-grey material; no light
# (autoheadlight).
def Xform "World"
{
    def Camera "cam"
    {
        float focalLength = 50.0
        float horizontalAperture = 36.0
        float verticalAperture = 27.0
        float2 clippingRange = (0.01, 10000)
        
    }
    def Mesh "q0" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-2.9, -0.5, -8.0), (-1.9, -0.5, -8.0), (-1.9, 0.5, -8.0), (-2.9, 0.5, -8.0)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Looks/grey>
        color3f[] primvars:displayColor = [(0.8, 0.5, 0.2)] (interpolation = "constant")
    }
    def Mesh "q30" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1.6330127018922194, -0.5, -7.75), (-0.7669872981077805, -0.5, -8.25), (-0.7669872981077805, 0.5, -8.25), (-1.6330127018922194, 0.5, -7.75)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Looks/grey>
        color3f[] primvars:displayColor = [(0.8, 0.5, 0.2)] (interpolation = "constant")
    }
    def Mesh "q45" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.3535533905932738, -0.5, -7.646446609406726), (0.3535533905932738, -0.5, -8.353553390593273), (0.3535533905932738, 0.5, -8.353553390593273), (-0.3535533905932738, 0.5, -7.646446609406726)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Looks/grey>
        color3f[] primvars:displayColor = [(0.8, 0.5, 0.2)] (interpolation = "constant")
    }
    def Mesh "q60" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(0.95, -0.5, -7.56698729810778), (1.45, -0.5, -8.433012701892219), (1.45, 0.5, -8.433012701892219), (0.95, 0.5, -7.56698729810778)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Looks/grey>
        color3f[] primvars:displayColor = [(0.8, 0.5, 0.2)] (interpolation = "constant")
    }
    def Mesh "q75" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(2.2705904774487395, -0.5, -7.517037086855466), (2.5294095225512603, -0.5, -8.482962913144535), (2.5294095225512603, 0.5, -8.482962913144535), (2.2705904774487395, 0.5, -7.517037086855466)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Looks/grey>
        color3f[] primvars:displayColor = [(0.8, 0.5, 0.2)] (interpolation = "constant")
    }
    def Mesh "floor" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-20.0, -2.0, 0.0), (20.0, -2.0, 0.0), (20.0, -2.0, -20.0), (-20.0, -2.0, -20.0)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Looks/grey>
        color3f[] primvars:displayColor = [(0.8, 0.5, 0.2)] (interpolation = "constant")
    }
    def Mesh "wall" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-20.0, -2.0, -12.0), (20.0, -2.0, -12.0), (20.0, 10.0, -12.0), (-20.0, 10.0, -12.0)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Looks/grey>
        color3f[] primvars:displayColor = [(0.8, 0.5, 0.2)] (interpolation = "constant")
    }
    def Mesh "panel" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-2.0, 1.5, -9.0), (-0.5, 1.5, -9.0), (-0.5, 2.5, -9.0), (-2.0, 2.5, -9.0)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Looks/panel>
        color3f[] primvars:displayColor = [(0.1, 0.9, 0.1)] (interpolation = "constant")
    }
}
def Scope "Looks"
{
    def Material "grey"
    {
        token outputs:mtlx:surface.connect = </Looks/grey/s.outputs:out>
        def Shader "s"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.3, 0.6, 0.9)
            float inputs:base = 1
            float inputs:specular = 0.0
            float inputs:specular_roughness = 0.2
            float inputs:metalness = 0.0
            token outputs:out
        }
    }
    def Material "panel"
    {
        token outputs:mtlx:surface.connect = </Looks/panel/s.outputs:out>
        def Shader "s"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.0, 0.0, 0.0)
            float inputs:base = 1
            float inputs:specular = 0.0
            float inputs:specular_roughness = 0.2
            float inputs:metalness = 0.0
            float inputs:emission = 1
            color3f inputs:emission_color = (2.0, 2.0, 2.0)
            token outputs:out
        }
    }
}
