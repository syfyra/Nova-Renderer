            label   "Diffuse Limit"
            type    float
            size    1
            default { 1.0 }
            range   { 0 64 }
            help    "Diffuse bounces (fractions dither between the neighbouring integers). Past the limit, rays only collect light. Unset: Karma's diffuselimit."
            parmtag { "spare_category" "Limits" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "float" }
        }
        parm {
