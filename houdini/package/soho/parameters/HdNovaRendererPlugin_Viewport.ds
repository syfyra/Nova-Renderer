            label   "Clamp Direct"
            type    float
            size    1
            default { 0.0 }
            range   { 0 100 }
            help    "Clamps per sample what the camera sees directly and the light the first hit gathers (0: off)."
            parmtag { "spare_category" "Sampling" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "float" }
        }
        parm {
            name    "xn__novaiprProxyDepth_p3a"
            label   "IPR Proxy Passes"
            type    int
            size    1
            default { 2 }
            range   { 0 3 }
            help    "After an edit the viewport first renders one pixel per 4x4, then per 2x2 block, for a fast first image; those samples count towards the image. 0: full passes only. Unset: Karma's ipr_proxydepth."
            parmtag { "spare_category" "Sampling" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "int" }
        }
    }
    groupcollapsible {
        name    "nova_vp_limits"
