/// Automatically generated by houdini/tools/gen_nova_ds.py from
/// houdini/tools/nova_settings.json: do not edit by hand.
/// Viewport display options of Nova XPU: the interactive subset.

#include "$HFS/houdini/soho/parameters/CommonMacros.ds"
{
    name    "nova"
    label   "Nova"
    parmtag { spare_opfilter "!!SHOP/PROPERTIES!!" }
    parmtag { spare_classtags "render" }
    groupcollapsible {
        name    "nova_vp_sampling"
        label   "Sampling"
        grouptag { "group_default" "1" }
        parm {
            name    "xn__novasamples_xta"
            label   "Samples"
            type    int
            size    1
            default { 64 }
            range   { 1 4096 }
            help    "Samples per pixel. Unset: Karma's samples (Path Traced: pathtracedsamples; Variance and Distributed: samplesperpixel times varianceaa_maxsamples)."
            parmtag { "spare_category" "Sampling" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "int" }
        }
        parm {
            name    "xn__novasampleScale_g0a"
            label   "Sample Scale"
            type    float
            size    1
            default { 1.0 }
            range   { 0.05 4 }
            help    "Multiplies the samples per pixel, Nova's or Karma's; at least one sample remains. 0.25 previews a scene that is set up for its final quality at a quarter of the render time."
            parmtag { "spare_category" "Sampling" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "float" }
        }
        parm {
            name    "xn__novapixelFilter_g0a"
            label   "Pixel Filter"
            type    string
            size    1
            default { "gauss" }
            menu {
                "gauss" "Gaussian"
                "box" "Box"
                "triangle" "Triangle"
                "blackman" "Blackman"
                "blackmanharris" "Blackman-Harris"
                "point" "Point"
            }
            help    "The pixel reconstruction filter. Unset: Karma's pixelfilter."
            parmtag { "spare_category" "Sampling" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "token" }
        }
        parm {
            name    "xn__novapixelFilterScale_l8a"
            label   "Pixel Filter Scale"
            type    float
            size    1
            default { 1.0 }
            range   { 0 4 }
            help    "Multiplies the filter's width (0: point sampling). Unset: Karma's pixelfilterscale."
            parmtag { "spare_category" "Sampling" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "float" }
        }
        parm {
            name    "xn__novaclampIndirect_p3a"
            label   "Clamp Indirect"
            type    float
            size    1
            default { 10.0 }
            range   { 0 100 }
            help    "Clamps indirect light per sample against fireflies (0: off). Unset (and Clamp Direct unset): Karma's colour limits (colorlimit for what the camera sees and the first hit gathers, colorlimitindirect for the rest, emission found by the first bounce counting as indirect)."
            parmtag { "spare_category" "Sampling" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "float" }
        }
        parm {
            name    "xn__novaclampDirect_g0a"
            label   "Clamp Direct"
            type    float
            size    1
            default { 0.0 }
            range   { 0 100 }
            help    "Clamps per sample what the camera sees directly and the light the first hit gathers (0: off)."
            parmtag { "spare_category" "Sampling" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "float" }
        }
        parm {
            name    "xn__novaiprProxyDepth_p3a"
            label   "IPR Proxy Passes"
            type    int
            size    1
            default { 2 }
            range   { 0 3 }
            help    "After an edit the viewport first renders one pixel per 4x4, then per 2x2 block, for a fast first image; those samples count towards the image. 0: full passes only. Unset: Karma's ipr_proxydepth."
            parmtag { "spare_category" "Sampling" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "int" }
        }
    }
    groupcollapsible {
        name    "nova_vp_limits"
        label   "Limits"
        grouptag { "group_default" "1" }
        parm {
            name    "xn__novamaxDepth_kva"
            label   "Max Ray Depth"
            type    int
            size    1
            default { 64 }
            range   { 1 64 }
            help    "A safety cap on the scattering events of a path; the per-type limits decide the look."
            parmtag { "spare_category" "Limits" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "int" }
        }
        parm {
            name    "xn__novaobjectdiffuseLimit_ucbg"
            label   "Diffuse Limit"
            type    float
            size    1
            default { 1.0 }
            range   { 0 64 }
            help    "Diffuse bounces (fractions dither between the neighbouring integers). Past the limit, rays only collect light. Unset: Karma's diffuselimit."
            parmtag { "spare_category" "Limits" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "float" }
        }
        parm {
            name    "xn__novaobjectreflectLimit_ucbg"
            label   "Reflection Limit"
            type    float
            size    1
            default { 4.0 }
            range   { 0 64 }
            help    "Glossy and mirror reflection bounces. Unset: Karma's reflectlimit."
            parmtag { "spare_category" "Limits" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "float" }
        }
        parm {
            name    "xn__novaobjectrefractLimit_ucbg"
            label   "Refraction Limit"
            type    float
            size    1
            default { 4.0 }
            range   { 0 64 }
            help    "Refraction bounces. Unset: Karma's refractlimit."
            parmtag { "spare_category" "Limits" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "float" }
        }
    }
    groupcollapsible {
        name    "nova_vp_look_development"
        label   "Look Development"
        grouptag { "group_default" "1" }
        parm {
            name    "xn__novalightOverride_p3a"
            label   "Light Override"
            type    string
            size    1
            default { "off" }
            menu {
                "off" "Off"
                "emissive" "Emissive Objects"
                "headlight" "Headlight"
                "dome" "Dome Light"
            }
            help    "Replaces the stage's lights: Emissive Objects leaves only emissive geometry, Headlight lights along the camera's view, Dome Light is a white dome. Neither the headlight nor the dome is seen by the camera. Unset: Karma's override_lighting."
            parmtag { "spare_category" "Look Development" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "token" }
        }
        parm {
            name    "xn__novaautoHeadlight_p3a"
            label   "Headlight Without Lights"
            type    toggle
            size    1
            default { 0 }
            help    "Lights a stage that has no light with a headlight (emissive geometry does not count as a light). Unset: Karma's autoheadlight."
            parmtag { "spare_category" "Look Development" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "bool" }
        }
        parm {
            name    "xn__novasimplifiedShading_79a"
            label   "Simplified Shading"
            type    toggle
            size    1
            default { 0 }
            help    "Shades what the camera sees with its display colour (white without one) by how much it faces the camera, darkened by ambient occlusion, with the fog below and the material's emission: no lights, no bounces. A fast look at a heavy scene's shapes. Unset: Karma's Simplified Shading (disable_lighting)."
            parmtag { "spare_category" "Look Development" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "bool" }
        }
        parm {
            name    "xn__novaambientOcclusion_l8a"
            label   "Ambient Occlusion"
            type    toggle
            size    1
            default { 1 }
            help    "Simplified Shading darkens corners and contact areas. Unset: Karma's head_ao_samples (0 is off)."
            parmtag { "spare_category" "Look Development" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "bool" }
        }
        parm {
            name    "xn__novaaoDistance_tya"
            label   "Ambient Occlusion Distance"
            type    float
            size    1
            default { 0.0 }
            range   { 0 100 }
            help    "How far away a surface may be to occlude, in scene units (0: at any distance). Unset: Karma's head_ao_distance."
            parmtag { "spare_category" "Look Development" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "float" }
        }
    }
    groupcollapsible {
        name    "nova_vp_outlines"
        label   "Outlines"
        grouptag { "group_default" "1" }
        parm {
            name    "xn__novaoutline_xta"
            label   "Outlines"
            type    toggle
            size    1
            default { 0 }
            help    "Toon lines where the camera sees an object's silhouette, a crease or a step in depth (the line types are per-object properties). With this switch the lines are drawn into the beauty whether or not the render has an outline AOV. Unset: Karma's outline_enable, which draws lines only in renders with an outline AOV."
            parmtag { "spare_category" "Outlines" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "bool" }
        }
        parm {
            name    "xn__novaoutlineRadius_p3a"
            label   "Outline Radius"
            type    float
            size    1
            default { 1.0 }
            range   { 0 10 }
            help    "Multiplies the objects' line widths. Unset: Karma's outline_radius."
            parmtag { "spare_category" "Outlines" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "float" }
        }
    }
    groupcollapsible {
        name    "nova_vp_denoising"
        label   "Denoising"
        grouptag { "group_default" "1" }
        parm {
            name    "xn__novadenoiser_kva"
            label   "Denoiser"
            type    string
            size    1
            default { "auto" }
            menu {
                "auto" "Automatic"
                "optix" "NVIDIA OptiX"
                "oidn" "Intel Open Image Denoise"
            }
            help    "The denoiser of final frames and of the viewport. Automatic: NVIDIA OptiX where it can run, Intel Open Image Denoise elsewhere (machines without an NVIDIA GPU; it then runs on the CPU). A denoiser that cannot run gives way to the other, with a message. Unset or Automatic: the engine of Karma's Denoiser menu, if it names one."
            parmtag { "spare_category" "Denoising" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "token" }
        }
        parm {
            name    "xn__novadenoiseQuality_c5a"
            label   "Denoise Quality"
            type    string
            size    1
            default { "auto" }
            menu {
                "auto" "Automatic"
                "fast" "Fast"
                "balanced" "Balanced"
                "high" "High"
            }
            help    "The quality of Intel Open Image Denoise's filter, slower with each step. Automatic: High for final frames, Balanced in the viewport. NVIDIA OptiX has one quality."
            parmtag { "spare_category" "Denoising" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "token" }
        }
        parm {
            name    "xn__novadenoiseAlbedo_p3a"
            label   "Denoise with Albedo"
            type    toggle
            size    1
            default { 1 }
            help    "Hands the denoiser the albedo at the first hit as a guide, which keeps the detail of textures apart from noise. Unset: the Use Albedo switch of Karma's Denoiser for final frames, on in the viewport."
            parmtag { "spare_category" "Denoising" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "bool" }
        }
        parm {
            name    "xn__novadenoiseNormal_p3a"
            label   "Denoise with Normals"
            type    toggle
            size    1
            default { 1 }
            help    "Hands the denoiser the normal at the first hit as a guide, which keeps edges and bumps; Open Image Denoise uses it only together with the albedo. Unset: the Use N switch of Karma's Denoiser for final frames, on in the viewport."
            parmtag { "spare_category" "Denoising" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "bool" }
        }
        parm {
            name    "xn__novaviewportDenoise_y6a"
            label   "Denoise the Viewport"
            type    toggle
            size    1
            default { 0 }
            help    "Shows the viewport's image denoised (by the Denoiser of the render settings). Unset: Karma's viewport denoise toggle."
            parmtag { "spare_category" "Denoising" }
            parmtag { "uiscope" "viewport toolbar" }
            parmtag { "usdvaluetype" "bool" }
            parmtag { "uiicon" VIEW_display_denoise }
        }
        parm {
            name    "xn__novadenoiseStartPasses_ucb"
            label   "Denoise Start Passes"
            type    int
            size    1
            default { 4 }
            range   { 1 32 }
            help    "The viewport shows the noisy image for the first passes after an edit, then the denoised one."
            parmtag { "spare_category" "Denoising" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "int" }
        }
    }
    groupcollapsible {
        name    "nova_vp_geometry"
        label   "Geometry"
        grouptag { "group_default" "1" }
        parm {
            name    "xn__novasubdivLevel_g0a"
            label   "Subdivision Level"
            type    int
            size    1
            default { -1 }
            range   { -1 6 }
            help    "Uniform subdivision level of subdivision surfaces (-1: from the display complexity)."
            parmtag { "spare_category" "Geometry" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "int" }
        }
        parm {
            name    "xn__novadicingQualityScale_ucb"
            label   "Dicing Quality Scale"
            type    float
            size    1
            default { 1.0 }
            range   { 0.1 4 }
            help    "Multiplies every object's displacement dicing quality. Unset: Karma's dicingqualityscale."
            parmtag { "spare_category" "Geometry" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "float" }
        }
    }
    groupcollapsible {
        name    "nova_vp_textures"
        label   "Textures"
        grouptag { "group_default" "1" }
        parm {
            name    "xn__novatextureFilterWidth_ucb"
            label   "Texture Filter Width"
            type    float
            size    1
            default { 0.25 }
            range   { 0 4 }
            help    "Texture footprint relative to the pixel's ray cone (0.25 as Karma; 0: the finest MIP level). Unset: a quarter of Karma's mtlx_imagewidth."
            parmtag { "spare_category" "Textures" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "float" }
        }
    }
}
