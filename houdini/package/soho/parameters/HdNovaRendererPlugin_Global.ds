            parm {
                name    "xn__novaobjectlightSource_79ag"
                label   "Efficient Emission Sampling"
                type    int
                size    1
                default { 0 }
                menu {
                    "0" "No"
                    "1" "Yes"
                    "2" "Auto"
                }
                help    "Treats an emissive mesh or volume as a light source: its emission is light-sampled (much less noise on what it lights) and is a light (L) in light path expressions, also for the camera. Yes and Auto both treat the parts whose material emits. Moving meshes and VEX materials stay plain emitters. Unset: Karma's treat_as_lightsource, whose light multipliers (lightsource_diffusescale and specularscale) Nova reads as well."
                parmtag { "spare_category" "Light" }
                parmtag { "uiscope" "None" }
                parmtag { "usdvaluetype" "int" }
                disablewhen "{ xn__novaobjectlightSource_control_8nbg == block } { xn__novaobjectlightSource_control_8nbg == none }"
