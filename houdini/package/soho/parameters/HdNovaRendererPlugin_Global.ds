                }
                parmtag { "sidefx::look" "icon" }
            }
            parm {
                name    "xn__novasamples_xta"
                label   "Samples"
                type    int
                size    1
                default { 64 }
                range   { 1 4096 }
                help    "Samples per pixel. Unset: Karma's samples (Path Traced: pathtracedsamples; Variance and Distributed: samplesperpixel times varianceaa_maxsamples)."
                parmtag { "spare_category" "Sampling" }
                parmtag { "uiscope" "None" }
                parmtag { "usdvaluetype" "int" }
                disablewhen "{ xn__novasamples_control_y6a == block } { xn__novasamples_control_y6a == none }"
