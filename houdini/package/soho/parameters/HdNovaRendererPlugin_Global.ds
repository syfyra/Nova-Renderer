                parmtag { "sidefx::look" "icon" }
            }
            parm {
                name    "xn__novalightStrategy_p3a"
                label   "Light Sampling"
                type    string
                size    1
                default { "mis" }
                menu {
                    "mis" "Multiple Importance"
                    "light" "Light Samples Only"
                    "bsdf" "BSDF Samples Only"
                }
                help    "Debugging aid: which estimators sample direct light."
                parmtag { "spare_category" "Debug" }
                parmtag { "uiscope" "None" }
                parmtag { "usdvaluetype" "token" }
                disablewhen "{ xn__novalightStrategy_control_qhb == block } { xn__novalightStrategy_control_qhb == none }"
            }
        }
