                default { 1.0 }
                range   { 0 10 }
                help    "Multiplies the widths of curves and points. Unset: Karma's width_scale."
                parmtag { "spare_category" "Curves and Points" }
                parmtag { "uiscope" "None" }
                parmtag { "usdvaluetype" "float" }
                disablewhen "{ xn__novaobjectwidthScale_control_mmbg == block } { xn__novaobjectwidthScale_control_mmbg == none }"
            }
            parm {
                name    "xn__novaobjectpointStyle_control_mmbg"
                label   "Point Style"
                type    string
                default { "none" }
                menujoin {
                    [ "import loputils" ]
                    [ "return loputils.createEditPropertiesControlMenu(kwargs, 'int')" ]
                    language python
                }
                parmtag { "sidefx::look" "icon" }
            }
            parm {
                name    "xn__novaobjectpointStyle_l8ag"
                label   "Point Style"
                type    int
                size    1
                default { 1 }
                menu {
                    "0" "Disc Facing the Ray"
                    "1" "Sphere"
                    "2" "Disc Facing the Normal"
                }
                help    "How points render: discs turned towards each ray, spheres, or discs facing the points' normals (facing the ray where there are none). Unset: Karma's point_style."
                parmtag { "spare_category" "Curves and Points" }
                parmtag { "uiscope" "None" }
                parmtag { "usdvaluetype" "int" }
                disablewhen "{ xn__novaobjectpointStyle_control_mmbg == block } { xn__novaobjectpointStyle_control_mmbg == none }"
            }
        }
        groupcollapsible {
            name    "nova_object_motion_blur"
            label   "Motion Blur"
            grouptag { "group_default" "1" }
            parm {
                name    "xn__novaobjectvelocityBlur_control_vpbg"
                label   "Velocity Blur"
                type    string
                default { "none" }
                menujoin {
                    [ "import loputils" ]
                    [ "return loputils.createEditPropertiesControlMenu(kwargs, 'int')" ]
                    language python
                }
                parmtag { "sidefx::look" "icon" }
            }
            parm {
                name    "xn__novaobjectvelocityBlur_ucbg"
                label   "Velocity Blur"
                type    int
                size    1
                default { 0 }
                menu {
                    "0" "No Velocity Blur"
                    "1" "Velocity Blur"
                    "2" "Acceleration Blur"
                }
                help    "Motion blur of meshes, curves and points from their velocities (v in SOPs, units per second) instead of their time samples, for geometry whose point count changes from frame to frame. Velocity Blur moves the points in straight lines over the shutter; Acceleration Blur bends the paths with the accelerations (accel), sampled Acceleration Samples times. Volumes blur by their velocity field when this is on (both modes move them linearly; Karma's volumevblurscale scales it). Unset: Karma's vblur (on the object, else on the render settings)."
                parmtag { "spare_category" "Motion Blur" }
                parmtag { "uiscope" "None" }
                parmtag { "usdvaluetype" "int" }
                disablewhen "{ xn__novaobjectvelocityBlur_control_vpbg == block } { xn__novaobjectvelocityBlur_control_vpbg == none }"
            }
            parm {
                name    "xn__novaobjectinstanceVelocityBlur_control_w2bg"
                label   "Instance Velocity Blur"
                type    string
                default { "none" }
                menujoin {
                    [ "import loputils" ]
                    [ "return loputils.createEditPropertiesControlMenu(kwargs, 'int')" ]
                    language python
                }
                parmtag { "sidefx::look" "icon" }
            }
            parm {
                name    "xn__novaobjectinstanceVelocityBlur_vpbg"
                label   "Instance Velocity Blur"
                type    int
                size    1
                default { 0 }
                menu {
                    "0" "No Velocity Blur"
                    "1" "Velocity Blur"
                    "2" "Acceleration Blur"
                }
                help    "Set on a point instancer: its instances move with the instancer's velocities and turn with its angular velocities instead of following the time samples of their positions and orientations; Acceleration Blur adds the accelerations. Unset: Karma's instance_vblur (on the instancer, else on the render settings)."
                parmtag { "spare_category" "Motion Blur" }
                parmtag { "uiscope" "None" }
                parmtag { "usdvaluetype" "int" }
                disablewhen "{ xn__novaobjectinstanceVelocityBlur_control_w2bg == block } { xn__novaobjectinstanceVelocityBlur_control_w2bg == none }"
            }
            parm {
                name    "xn__novaobjectaccelerationSamples_control_90bg"
                label   "Acceleration Samples"
                type    string
                default { "none" }
                menujoin {
                    [ "import loputils" ]
                    [ "return loputils.createEditPropertiesControlMenu(kwargs, 'int')" ]
                    language python
                }
                parmtag { "sidefx::look" "icon" }
            }
            parm {
                name    "xn__novaobjectaccelerationSamples_8nbg"
                label   "Acceleration Samples"
                type    int
                size    1
                default { 2 }
                range   { 2 16 }
                help    "How many times Acceleration Blur samples the shutter (Max Motion Steps caps it); 2 is a straight line from shutter open to close. Unset: Karma's geosamples, on point instancers its instance_samples."
                parmtag { "spare_category" "Motion Blur" }
                parmtag { "uiscope" "None" }
                parmtag { "usdvaluetype" "int" }
                disablewhen "{ xn__novaobjectaccelerationSamples_control_90bg == block } { xn__novaobjectaccelerationSamples_control_90bg == none }"
            }
        }
    }
}
