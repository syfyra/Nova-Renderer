                size    1
                default { 0 }
                range   { 0 256 }
                help    "The samples per pixel that keep improving what guiding learned; the rest of the render uses it as it is then. 0: learn throughout the render. Unset: Karma's guiding_samples (primary samples: with Karma's Variance or Distributed sampling, times the maximum secondary samples)."
                parmtag { "spare_category" "Indirect Guiding" }
                parmtag { "uiscope" "None" }
