                label   "Enable Indirect Guiding"
                type    toggle
                size    1
                default { 0 }
                help    "Path guiding: Nova learns from the first samples where indirect light comes from and sends more indirect rays there, on the CPU and the GPU. The image stays the same; its noise drops where indirect light comes from small or hidden parts of the scene (a room lit through a window, light behind a wall), and the renders stay deterministic. Unset: Karma's guiding_enable."
                parmtag { "spare_category" "Indirect Guiding" }
                parmtag { "uiscope" "None" }
                parmtag { "usdvaluetype" "bool" }
