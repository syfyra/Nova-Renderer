                    [ "return loputils.createEditPropertiesControlMenu(kwargs, 'float')" ]
                    language python
                }
                parmtag { "sidefx::look" "icon" }
            }
            parm {
                name    "xn__novatextureFilterWidth_ucb"
                label   "Texture Filter Width"
                type    float
                size    1
                default { 0.25 }
                range   { 0 4 }
                help    "Texture footprint relative to the pixel's ray cone (0.25 as Karma; 0: the finest MIP level)."
                parmtag { "spare_category" "Textures" }
                parmtag { "uiscope" "None" }
                parmtag { "usdvaluetype" "float" }
                disablewhen "{ xn__novatextureFilterWidth_control_vpb == block } { xn__novatextureFilterWidth_control_vpb == none }"
            }
            parm {
                name    "xn__novaabortOnMissingTexture_control_rub"
                label   "Abort on Missing Texture"
                type    string
                default { "none" }
                menujoin {
                    [ "import loputils" ]
                    [ "return loputils.createEditPropertiesControlMenu(kwargs, 'bool')" ]
                    language python
                }
                parmtag { "sidefx::look" "icon" }
            }
            parm {
                name    "xn__novaabortOnMissingTexture_qhb"
                label   "Abort on Missing Texture"
                type    toggle
                size    1
                default { 0 }
                help    "Stops the render when a texture file cannot be read."
                parmtag { "spare_category" "Textures" }
                parmtag { "uiscope" "None" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen "{ xn__novaabortOnMissingTexture_control_rub == block } { xn__novaabortOnMissingTexture_control_rub == none }"
            }
            parm {
                name    "xn__novatextureStats_control_3fb"
                label   "Texture Statistics"
                type    string
                default { "none" }
                menujoin {
                    [ "import loputils" ]
                    [ "return loputils.createEditPropertiesControlMenu(kwargs, 'int')" ]
                    language python
                }
                parmtag { "sidefx::look" "icon" }
            }
            parm {
                name    "xn__novatextureStats_21a"
                label   "Texture Statistics"
                type    int
                size    1
                default { 0 }
                range   { 0 5 }
                help    "OpenImageIO texture statistics level printed at the end of a render."
                parmtag { "spare_category" "Textures" }
                parmtag { "uiscope" "None" }
                parmtag { "usdvaluetype" "int" }
                disablewhen "{ xn__novatextureStats_control_3fb == block } { xn__novatextureStats_control_3fb == none }"
            }
            parm {
                name    "xn__novagpuTextureBudget_control_mmb"
                label   "GPU Texture Budget"
                type    string
                default { "none" }
                menujoin {
                    [ "import loputils" ]
                    [ "return loputils.createEditPropertiesControlMenu(kwargs, 'int')" ]
                    language python
                }
                parmtag { "sidefx::look" "icon" }
            }
            parm {
                name    "xn__novagpuTextureBudget_l8a"
                label   "GPU Texture Budget"
                type    int
                size    1
                default { 0 }
                range   { 0 65536 }
                help    "The GPU memory for textures with Nova XPU, in MB (0: half the memory free when the first texture loads). Past it the finest MIP levels of further textures are left out, with a warning."
                parmtag { "spare_category" "Textures" }
                parmtag { "uiscope" "None" }
                parmtag { "usdvaluetype" "int" }
                disablewhen "{ xn__novagpuTextureBudget_control_mmb == block } { xn__novagpuTextureBudget_control_mmb == none }"
            }
        }
        groupcollapsible {
            name    "nova_debug"
            label   "Debug"
            grouptag { "group_default" "1" }
            parm {
                name    "xn__novalightStrategy_control_qhb"
                label   "Light Sampling"
                type    string
                default { "none" }
                menujoin {
                    [ "import loputils" ]
