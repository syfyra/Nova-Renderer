                    customData = {
                        int[] HoudiniPrimEditorNodes = [63]
                    }
                )
            }

            def RenderVar "CryptoMaterials" (
                apiSchemas = ["KarmaRenderVarAPI", "HuskRenderVarAPI"]
                customData = {
                    int[] HoudiniPrimEditorNodes = [66]
                }
            )
            {
                uniform token dataType = "float3" (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [66]
                    }
                )
                float driver:parameters:aov:husk:clearValue = 0 (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [66]
                    }
                )
                token driver:parameters:aov:husk:format = "float3" (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [66]
                    }
                )
                bool driver:parameters:aov:husk:multiSampled = 0 (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [66]
                    }
                )
                string driver:parameters:aov:husk:name = "CryptoMaterials" (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [66]
                    }
                )
                bool driver:parameters:aov:karma:cryptomatte = 1 (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [66]
                    }
                )
                int driver:parameters:aov:karma:cryptomatterank = 6 (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [66]
                    }
                )
                string driver:parameters:aov:karma:cryptomattesidecar = "" (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [66]
                    }
                )
                string driver:parameters:aov:karma:filter = '["ubox",{}]' (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [66]
                    }
                )
                uniform string sourceName = "__materialname" (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [66]
                    }
                )
                uniform token sourceType = "primvar" (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [66]
                    }
                )
            }
        }
    }

    def RenderSettings "krs" (
        apiSchemas = ["KarmaRenderSettingsAPI", "HuskRenderSettingsAPI", "HuskRenderProductAPI"]
        customData = {
            int[] HoudiniPrimEditorNodes = [33]
        }
    )
    {
        uniform token aspectRatioConformPolicy = "expandAperture" (
            customData = {
                int[] HoudiniPrimEditorNodes = [33]
            }
        )
        rel camera = </cam>
        uniform float4 dataWindowNDC = (0, 0, 1, 1) (
            customData = {
                int[] HoudiniPrimEditorNodes = [33]
            }
        )
        uniform bool disableDepthOfField = 0 (
            customData = {
                int[] HoudiniPrimEditorNodes = [33]
            }
        )
        uniform bool disableMotionBlur = 0 (
            customData = {
                int[] HoudiniPrimEditorNodes = [33]
            }
        )
        string husk:default_delegate = "BRAY_HdKarma"
        rel husk:orderedImageFilters
        bool husk:scene_lights = 1
        bool husk:scene_materials = 1
        uniform token[] includedPurposes = ["default", "render"] (
            customData = {
                int[] HoudiniPrimEditorNodes = [33]
            }
        )
        bool karma:global:abortmissingtexture = 0
        bool karma:global:abortnogpudevice = 0
        bool karma:global:autoraybias = 1
        token karma:global:bucketorder = "Middle"
        int karma:global:bucketsize = 32
        float karma:global:cacheratio = 0.25
        int karma:global:cachesize = 1000
        float karma:global:colorlimit = 20
        float karma:global:colorlimitindirect = 20
        bool karma:global:colorlimitindlinked = 1
        bool karma:global:constrainmaxrough = 1
        token karma:global:convergence_mode = "Variance"
        bool karma:global:dcm_excludeholdouts = 0
        bool karma:global:dcm_usehitdist = 0
        float karma:global:dicingqualityscale = 1
        string karma:global:diffusecomponents = "diffuse"
        custom bool karma:global:enable_dof = 1
        string karma:global:exportcomponents = "diffuse reflect coat refract volume sss"
        string karma:global:globalaovmaterial = ""
        bool karma:global:guiding_enable = 0
        int karma:global:guiding_samples = 0
        bool karma:global:image_blur = 1
        string karma:global:imagefilter = "[]"
        token karma:global:imagemode = "Progressive"
        token karma:global:light_sampling_mode = "Light Tree"
        float karma:global:light_sampling_quality = 1
        float karma:global:offscreenquality = 0.1
        bool karma:global:outline_apply = 1
        float3 karma:global:outline_color = (1, 0, 1)
        bool karma:global:outline_debug = 0
        float karma:global:outline_depthblend = 0
        float karma:global:outline_depththreshold = 1
        bool karma:global:outline_enable = 0
        float karma:global:outline_fitmax = 1
        float karma:global:outline_fitmin = 0
        float karma:global:outline_intensity = 1
        bool karma:global:outline_linesaovs = 0
        bool karma:global:outline_mode = 0
        bool karma:global:outline_primary = 1
        int karma:global:outline_primary_samples = 4
        int karma:global:outline_primary_stencils = 1
        float karma:global:outline_radius = 1
        bool karma:global:outline_secondary = 1
        int karma:global:outline_secondary_samples = 4
        int karma:global:outline_secondary_stencils = 1
        int karma:global:pathtracedsamples = 128
        string karma:global:pixelfilter = "gauss"
        float karma:global:pixelfilterscale = 1
        string karma:global:pixeloracle = '["variance", {"minrays": -1, "plane": "C", "variance": 0.01, "ociomode": 0, "ociodisplay": "sRGB - Display", "ocioview": "", "ociocolorspace": "default"}]'
        float karma:global:raybias = 0.001
        string karma:global:refractcomponents = "refract"
        int karma:global:russianroulette_cutoff = 2
        int karma:global:samplesperpixel = 16
        int karma:global:screendoorlimit = 4
        string karma:global:ssscomponents = "sss"
        bool karma:global:usecacheratio = 1
        string karma:global:volumecomponents = "volume"
        custom token karma:object:blurstyle = "Rotation Blur"
        custom bool karma:object:causticsenable = 0
        custom float karma:object:causticsroughnessclamp = 0.2
        custom token karma:object:cull_backface = "Off"
        custom int karma:object:curve_basis = 0
        custom token karma:object:curve_style = "Rounded Curves"
        custom float karma:object:diffuselimit = 1
        custom float karma:object:diffusequality = 1
        custom int karma:object:geosamples = 2
        custom int karma:object:instance_samples = 2
        custom token karma:object:instance_vblur = "No Velocity Blur"
        custom bool karma:object:mblur = 1
        custom token karma:object:point_style = "Spheres"
        custom float karma:object:reflectlimit = 4
        custom float karma:object:reflectquality = 1
        custom float karma:object:refractlimit = 4
        custom float karma:object:refractquality = 1
        custom bool karma:object:samplesfromstage = 1
        custom float karma:object:ssslimit = 1
        custom float karma:object:sssquality = 1
        custom string karma:object:truedisplace = "True Displacement"
        custom int karma:object:varianceaa_maxsamples = 9
        custom int karma:object:varianceaa_minsamples = 1
        custom float karma:object:varianceaa_thresh = 0.01
        custom token karma:object:vblur = "No Velocity Blur"
        custom float karma:object:volumelimit = 0
        custom float karma:object:volumequality = 1
        custom float karma:object:volumesteprate = 0.25
        custom float karma:object:volumevblurscale = 1
        custom int karma:object:xformsamples = 2
        uniform token[] materialBindingPurposes = ["full", ""] (
            customData = {
                int[] HoudiniPrimEditorNodes = [33]
            }
        )
        uniform float pixelAspectRatio = 1 (
            customData = {
                int[] HoudiniPrimEditorNodes = [33]
            }
        )
        rel products = </Render/krs/Products/renderproduct>
        uniform int2 resolution = (480, 270) (
            customData = {
                int[] HoudiniPrimEditorNodes = [33]
            }
        )

        def Scope "Products"
        {
            def RenderProduct "renderproduct" (
                apiSchemas = ["HuskRenderProductAPI"]
            )
            {
                string driver:parameters:husk:artist = ""
                string driver:parameters:husk:comment = ""
                string driver:parameters:husk:hostname = ""
                string driver:parameters:husk:OpenEXR:compression = "zips"
                int driver:parameters:husk:OpenEXR:dwa_compression = 85
                rel orderedVars = [
                    </Render/krs/Vars/beauty>,
                    </Render/krs/Vars/beauty_emission>,
                    </Render/krs/Vars/beauty_fill>,
                    </Render/krs/Vars/beauty_key>,
                    </Render/krs/Vars/beautyunshadowed>,
                    </Render/krs/Vars/shadow>,
                    </Render/krs/Vars/combineddiffuse>,
                    </Render/krs/Vars/combineddiffuse_emission>,
                    </Render/krs/Vars/combineddiffuse_fill>,
                    </Render/krs/Vars/combineddiffuse_key>,
                    </Render/krs/Vars/directdiffuse>,
                    </Render/krs/Vars/indirectdiffuse>,
                    </Render/krs/Vars/combineddiffuseunshadowed>,
                    </Render/krs/Vars/directdiffuseunshadowed>,
                    </Render/krs/Vars/indirectdiffuseunshadowed>,
                    </Render/krs/Vars/combineddiffuseshadow>,
                    </Render/krs/Vars/directdiffuseshadow>,
                    </Render/krs/Vars/indirectdiffuseshadow>,
                    </Render/krs/Vars/combinedglossyreflection>,
                    </Render/krs/Vars/directglossyreflection>,
                    </Render/krs/Vars/indirectglossyreflection>,
                    </Render/krs/Vars/glossytransmission>,
                    </Render/krs/Vars/visiblelights>,
                    </Render/krs/Vars/combinedemission>,
                    </Render/krs/Vars/directemission>,
                    </Render/krs/Vars/indirectemission>,
                    </Render/krs/Vars/combinedvolume>,
                    </Render/krs/Vars/directvolume>,
                    </Render/krs/Vars/indirectvolume>,
                    </Render/krs/Vars/coat>,
                    </Render/krs/Vars/sss>,
                    </Render/krs/Vars/hitP>,
                    </Render/krs/Vars/hitP_camera>,
                    </Render/krs/Vars/hitPz>,
                    </Render/krs/Vars/element>,
                    </Render/krs/Vars/primid>,
                    </Render/krs/Vars/hituv>,
                    </Render/krs/Vars/hitN>,
