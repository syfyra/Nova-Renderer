#usda 1.0
(
    doc = """Generated from Composed Stage of root layer 
"""
    framesPerSecond = 24
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/krs"
    timeCodesPerSecond = 24
)

def HoudiniLayerInfo "HoudiniLayerInfo" (
    customData = {
        int HoudiniCreatorNode = 31
        int[] HoudiniEditorNodes = [31, 40]
        string HoudiniSaveControl = "Placeholder"
    }
)
{
}

def Camera "cam"
{
    float2 clippingRange = (0.1, 1000)
    float focalLength = 35
    float horizontalAperture = 36
    double shutter:close = 0.25
    double shutter:open = -0.25
    float verticalAperture = 20.25
    float xformOp:rotateX = -8
    double3 xformOp:translate = (0, 1.6, 8)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def Scope "World"
{
    def "geo"
    {
        def Mesh "ground" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            custom rel material:binding = </materials/kma_ground>
            point3f[] points = [(-10, 0, 10), (10, 0, 10), (10, 0, -10), (-10, 0, -10)]
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                interpolation = "faceVarying"
            )
            uniform token subdivisionScheme = "none"
        }

        def Sphere "coat" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding = </World/mtl/coat>
            double radius = 0.7
            double3 xformOp:translate = (-2.4, 0.7, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "glass" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding = </World/mtl/glass>
            double radius = 0.7
            double3 xformOp:translate = (-0.8, 0.7, 0.6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "sss" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding = </World/mtl/sss>
            double radius = 0.7
            double3 xformOp:translate = (0.8, 0.7, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "metal" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding = </World/mtl/metal>
            string primvars:karma:object:lpetag = "metal" (
                interpolation = "constant"
            )
            double radius = 0.7
            double3 xformOp:translate = (2.4, 0.7, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "emitter" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding = </World/mtl/emit>
            double radius = 0.25
            double3 xformOp:translate = (0, 0.25, 2.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cube "mover" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding = </World/mtl/grey>
            double size = 0.8
            double3 xformOp:translate.timeSamples = {
                0: (-0.5, 0.4, -1.8),
                1: (0.09999999999999998, 0.4, -1.8),
                2: (0.7, 0.4, -1.8),
            }
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def "mtl"
    {
        def Material "coat"
        {
            token outputs:mtlx:surface.connect = </World/mtl/coat/ss.outputs:out>

            def Shader "ss"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.8, 0.05, 0.05)
                float inputs:coat = 1
                float inputs:coat_roughness = 0.05
                float inputs:specular_roughness = 0.5
                token outputs:out
            }
        }

        def Material "glass"
        {
            token outputs:mtlx:surface.connect = </World/mtl/glass/ss.outputs:out>

            def Shader "ss"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 0
                float inputs:specular_roughness = 0
                float inputs:transmission = 1
                token outputs:out
            }
        }

        def Material "sss"
        {
            token outputs:mtlx:surface.connect = </World/mtl/sss/ss.outputs:out>

            def Shader "ss"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:subsurface = 1
                color3f inputs:subsurface_color = (0.9, 0.6, 0.4)
                color3f inputs:subsurface_radius = (1, 0.5, 0.25)
                float inputs:subsurface_scale = 0.3
                token outputs:out
            }
        }

        def Material "metal"
        {
            token outputs:mtlx:surface.connect = </World/mtl/metal/ss.outputs:out>

            def Shader "ss"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.95, 0.8, 0.5)
                float inputs:metalness = 1
                float inputs:specular_roughness = 0.25
                token outputs:out
            }
        }

        def Material "emit"
        {
            token outputs:mtlx:surface.connect = </World/mtl/emit/ss.outputs:out>

            def Shader "ss"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 0
                float inputs:emission = 1
                color3f inputs:emission_color = (4, 1.5, 0.3)
                token outputs:out
            }
        }

        def Material "grey"
        {
            token outputs:mtlx:surface.connect = </World/mtl/grey/ss.outputs:out>

            def Shader "ss"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.5, 0.5, 0.5)
                token outputs:out
            }
        }
    }

    def "lights"
    {
        def SphereLight "key"
        {
            float inputs:intensity = 100
            custom string inputs:karma:light:lpetag = "key"
            float inputs:radius = 0.5
            double3 xformOp:translate = (3, 5, 4)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def DistantLight "fill"
        {
            float inputs:angle = 5
            float inputs:intensity = 0.8
            custom string inputs:karma:light:lpetag = "fill"
            float xformOp:rotateX = -50
            float xformOp:rotateY = -35
            uniform token[] xformOpOrder = ["xformOp:rotateY", "xformOp:rotateX"]
        }

        def DomeLight "env"
        {
            color3f inputs:color = (0.6, 0.7, 1)
            float inputs:intensity = 0.3
        }
    }
}

def Scope "materials"
{
    def Material "kma_ground" (
        apiSchemas = ["MaterialXConfigAPI"]
        customData = {
            int[] HoudiniPrimEditorNodes = [12]
        }
    )
    {
        string config:mtlx:version = "1.39"
        token outputs:kma:displacement.connect = </materials/kma_ground/mtlxdisplacement.outputs:out>
        token outputs:kma:surface.connect = </materials/kma_ground/mtlxstandard_surface.outputs:out>
        vector3f outputs:myaov.connect = </materials/kma_ground/pos.outputs:out>
        token outputs:surface.connect = </materials/kma_ground/mtlxstandard_preview.outputs:surface>

        def Shader "mtlxstandard_surface" (
            apiSchemas = ["NodeGraphNodeAPI"]
            customData = {
                bool HoudiniHasAutoPreviewShader = 1
            }
        )
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            vector3f inputs:aov:myaov.connect = </materials/kma_ground/pos.outputs:out>
            float inputs:base (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1
                        string ogl_diff_intensity = "1"
                    }
                }
            )
            color3f inputs:base_color = (0.5, 0.5, 0.5) (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (0.8, 0.8, 0.8)
                        string ogl_diff = "1"
                    }
                }
            )
            float inputs:coat (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_coat_intensity = "1"
                    }
                }
            )
            float inputs:coat_roughness (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0.1
                        string ogl_coat_rough = "1"
                    }
                }
            )
            float inputs:emission (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_emit_intensity = "1"
                    }
                }
            )
            color3f inputs:emission_color (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (1, 1, 1)
                        string ogl_emit = "1"
                    }
                }
            )
            float inputs:metalness (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_metallic = "1"
                    }
                }
            )
            float inputs:specular (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1
                        string ogl_spec_intensity = "1"
                    }
                }
            )
            color3f inputs:specular_color (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (1, 1, 1)
                        string ogl_spec = "1"
                    }
                }
            )
            float inputs:specular_IOR (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1.5
                        string ogl_ior = "1"
                    }
                }
            )
            float inputs:specular_roughness (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0.2
                        string ogl_rough = "1"
                    }
                }
            )
            float inputs:transmission (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_transparency = "1"
                    }
                }
            )
            token outputs:out
            uniform float2 ui:nodegraph:node:pos = (-0.2883, 0.0376)
        }

        def Shader "mtlxdisplacement" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_displacement_float"
            token outputs:out
            uniform float2 ui:nodegraph:node:pos = (-0.2883, -2.4334)
        }

        def Shader "pos" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_position_vector3"
            vector3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (0, 0)
        }

        def Scope "Vars"
        {
            def RenderVar "myaov"
            {
                uniform token dataType = "vector3f"
                custom string driver:parameters:aov:husk:channel_prefix = "myaov"
                custom token driver:parameters:aov:husk:format = "float3"
                custom string driver:parameters:aov:husk:name = "myaov"
                custom string driver:parameters:aov:karma:filter = '["ubox",{}]'
                uniform string sourceName = "myaov"
                uniform token sourceType = "raw"
            }
        }

        def Shader "mtlxstandard_preview" (
            customData = {
                bool HoudiniIsAutoCreatedShader = 1
            }
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoatRoughness = 0.1
            color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
            float inputs:roughness = 0.2
            color3f inputs:specularColor = (1, 1, 1)
            token outputs:surface
        }
    }
}

def Scope "Render"
{
    def Scope "Products"
    {
        def Scope "Vars"
        {
            def RenderVar "myaov"
            {
                uniform token dataType = "vector3f"
                custom string driver:parameters:aov:husk:channel_prefix = "myaov"
                custom token driver:parameters:aov:husk:format = "float3"
                custom string driver:parameters:aov:husk:name = "myaov"
                custom string driver:parameters:aov:karma:filter = '["ubox",{}]'
                uniform string sourceName = "myaov"
                uniform token sourceType = "raw"
            }

            def RenderVar "CryptoPrimitives" (
