#usda 1.0
(
    subLayers = [@./materials.usda@]
)

def Camera "cam"
{
    double3 xformOp:translate = (0, 1.5, 8)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    float focalLength = 50
    float horizontalAperture = 41.4214
    float verticalAperture = 41.4214
}

def Scope "Render"
{
    def RenderSettings "rs"
    {
        rel camera = </cam>
        int2 resolution = (32, 32)
        rel products = </Render/prod>
    }
    def RenderProduct "prod"
    {
        token productName = "probe.exr"
        rel orderedVars = </Render/Vars/C>
    }
    def Scope "Vars"
    {
        def RenderVar "C"
        {
            uniform token dataType = "color4f"
            uniform string sourceName = "C.*[LO]"
            uniform token sourceType = "lpe"
            token driver:parameters:aov:format = "color4f"
            string driver:parameters:aov:name = "C"
        }
    }
}
