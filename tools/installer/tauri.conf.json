{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nova Setup",
  "version": "0.1.6",
  "identifier": "dev.nova.renderer.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nova Setup",
        "width": 720,
        "height": 460,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#f7f6f3"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
