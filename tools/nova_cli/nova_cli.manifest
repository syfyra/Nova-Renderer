<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The process's code page is UTF-8, as in Houdini's own executables: the
     command line, the environment and every narrow file name are UTF-8, which
     is what USD and the delegate take them for. Without it a scene, an image
     or a temporary folder whose name has a character outside ASCII is not
     found (Windows 10 1903 and later; older systems ignore the setting). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity type="win32" name="Nova.nova_cli" version="1.0.0.0"/>
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
